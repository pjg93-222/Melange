+body #view-graph .graph-filter-grid .chip-compare .scope-pill{max-width:170px}
+body #view-graph[data-compare]:not([data-compare=""]) .graph-filter-grid .chip-select:not(.chip-compare){flex:1 1 var(--chip-min,96px);
+  min-width:var(--chip-min,96px);max-width:max(var(--chip-w,128px),var(--chip-min,96px))}
+body #view-graph .graph-filter-grid.is-tight{gap:8px}
+body #view-graph .graph-filter-grid.is-tight .chip-select.chip-compare.can-add{padding-right:12px}
+body #view-graph .graph-filter-grid.is-tight .chip-compare::after{content:none}
