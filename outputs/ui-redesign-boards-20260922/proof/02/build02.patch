+   three scopes at 1440 - the pill chip takes a row of its own in the card
+   rather than cutting every pill to two letters. */
+body #view-graph .graph-header .graph-filter-grid.is-wrapped{flex-wrap:wrap;row-gap:8px}
+body #view-graph .graph-filter-grid.is-wrapped .chip-select.chip-compare{flex:1 1 100%;max-width:none}
+body #view-graph .graph-filter-grid .compare-clear{align-self:center;height:40px}
