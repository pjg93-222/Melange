; Downloads install layout (DL-spec 2.2). The DL_* names come from installer.generated.nsh (after-pack.cjs writes it from install-layout.cjs),
; which includes this file; nothing here hard-codes a folder name. Before the NSIS temp folder moves, only built-ins, LogicLib and
; FileFunc (script-only) may run: StdUtils (${isUpdated}) and System:: load their DLLs into $PLUGINSDIR, which must already be in the new $TEMP.
; A stale installer.generated.nsh (another version's folder names) must never be reused: it is regenerated by after-pack.cjs for every build.
!ifndef DL_VERSION
  !error "installer.generated.nsh is missing: build through electron-builder so after-pack.cjs writes it."
!endif
!ifdef VERSION
  !if "${DL_VERSION}" != "${VERSION}"
    !error "installer.generated.nsh is stale (DL_VERSION ${DL_VERSION}, build VERSION ${VERSION})."
  !endif
!endif
!include LogicLib.nsh
!include FileFunc.nsh
!macro customInstall
  ; Offline rollback baseline: an interactive (non-update) install keeps a copy of its own installer in the
  ; per-user baseline folder the app reads (main.cjs baselineRoot). The first rollback then needs no download;
  ; the app re-verifies the hash and the publisher before using it. Nothing elevated; any failure is ignored.
  ; Update trust is not set here: updates no longer depend on the release certificate being in the Trusted Root store.
  ; Per-machine (all users) installs skip it: the app reads the signed-in user's %LOCALAPPDATA%, which may not be the
  ; (elevated) installing account's, so their first rollback falls back to a network download.
  ${IfNot} ${isUpdated}
  ${AndIfNot} ${Silent}
  ${AndIf} $installMode == "CurrentUser"
    ClearErrors
    CreateDirectory "$LOCALAPPDATA\${APP_ID}\baseline\${VERSION}"
    CopyFiles /SILENT "$EXEPATH" "$LOCALAPPDATA\${APP_ID}\baseline\${VERSION}\$EXEFILE"
    ClearErrors
  ${EndIf}
  ; customInstall runs only after extraction and install registration succeeded.
  ; A silent update need not launch immediately, but its next-login receiver must use this version.
  ${If} $installMode == "CurrentUser"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Run" "${APP_ID}" '"$INSTDIR\${APP_EXECUTABLE_FILENAME}" --desktop-updater'
  ${EndIf}
  ; The shared Downloads container has no recursive removal action.
  Push $R0
  Push $R1
  Push $R2
  Push $R3
  !insertmacro dlRoot
  !insertmacro dlInstdirUnderRoot
  ${If} $R1 == "1"
    FileOpen $R2 "$R0\README - do not delete.txt" w
    FileWrite $R2 "This folder holds Melange Systems apps and their updates. Do not delete it while an app is installed.$\r$\n"
    FileClose $R2
  ${EndIf}
  Pop $R3
  Pop $R2
  Pop $R1
  Pop $R0
!macroend

; $R0 <- <Downloads>\${DL_ROOT_NAME}. Plugin-free: User Shell Folders + ExpandEnvStrings (the value Windows' Known Folder API reads), fallback $PROFILE\Downloads.
!macro dlRoot
  !ifdef DL_TEST_ROOT
    StrCpy $R0 "${DL_TEST_ROOT}"
  !else
    ReadRegStr $R0 HKCU "Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders" "${DL_KNOWN_FOLDER}"
    ExpandEnvStrings $R0 $R0
    ${If} $R0 == ""
      StrCpy $R0 "$PROFILE\Downloads"
    ${EndIf}
  !endif
  StrCpy $R0 "$R0\${DL_ROOT_NAME}"
!macroend
; $R1 <- "1" when $INSTDIR is under $R0 (NSIS string compare is case-insensitive). Callers supply $R0.
!macro dlInstdirUnderRoot
  StrLen $R2 "$R0\"
  StrCpy $R3 "$INSTDIR" $R2
  StrCpy $R1 "0"
  ${If} $R3 == "$R0\"
    StrCpy $R1 "1"
  ${EndIf}
!macroend
; Runs first in .onInit, before any plugin. Never runs in electron-builder's build-time uninstaller pass (it would run on the build PC).
!macro preInit
  !ifndef BUILD_UNINSTALLER
    !insertmacro dlRoot
    StrCpy $R6 "$R0\${DL_UPDATES_NAME}\${DL_SETUP_FOLDER}"
    StrLen $R7 $R6
    ${If} $R7 > ${DL_MAX_SETUP}
      MessageBox MB_OK|MB_ICONSTOP "The installer working folder path is too long:$\r$\n$R6" /SD IDOK
      SetErrorLevel 2
      Quit
    ${EndIf}
    CreateDirectory $R6
    UnsafeStrCpy $TEMP $R6
    InitPluginsDir
    System::Call 'kernel32::SetEnvironmentVariable(t "TEMP", t "$TEMP")'
    System::Call 'kernel32::SetEnvironmentVariable(t "TMP", t "$TEMP")'
  !endif
!macroend
; Every first install, update and rollback chooses this installer's version folder.
; No old program folder is uninstalled or recursively deleted. Profiles and access state remain outside it.
!macro dlDecideInstdir
  Push $R0
  Push $R2
  !insertmacro dlRoot
  StrCpy $INSTDIR "$R0\${DL_APP_FOLDER}"
  StrLen $R2 "$INSTDIR"
  ${If} $R2 > ${DL_MAX_DIR}
    MessageBox MB_OK|MB_ICONSTOP "The install folder path is too long for Windows:$\r$\n$INSTDIR$\r$\nUse a shorter Downloads location or tell IT this path." /SD IDOK
    SetErrorLevel 2
    Quit
  ${EndIf}
  Pop $R2
  Pop $R0
!macroend
; Runs after initMultiUser (installer.nsi), so plugins (loaded from the moved temp) may be used.
!macro customInit
  !insertmacro dlDecideInstdir
!macroend
; Per-user only: removes the "anyone / only me" page and its UAC and Program Files path (multiUserUi.nsh), which otherwise resets $INSTDIR on leave.
!macro customInstallMode
  StrCpy $isForceCurrentInstall "1"
!macroend
; The mode page's leave resets $INSTDIR (multiUser.nsh setInstallModePerUser). This hidden page, after where the directory page would be, re-applies the choice.
!macro customPageAfterChangeDir
  Function dlReforceInstdir
    !insertmacro dlDecideInstdir
    Abort
  FunctionEnd
  Page custom dlReforceInstdir
!macroend
