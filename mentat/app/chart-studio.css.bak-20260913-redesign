/* Chart Studio. Every colour is an ACU token from acu-theme.css; the only
   literals are the two pill fills named in the design brief (purple dimensions,
   teal measures), which are the same tokens the chart palette already uses. */

.workspace:has(#view-chart-studio:not([hidden])) { max-width: none; }

/* Verified facts share the original workbench's spacing and brand tokens. */
.studio-verified-summary {display:flex;flex-wrap:wrap;gap:20px;padding:10px 0 14px;border-bottom:1px solid var(--line);margin-bottom:14px;font-size:11px;color:var(--muted)}
.studio-verified-summary span {display:flex;flex-direction:column;gap:3px}
.studio-verified-summary strong {font-size:18px;font-weight:600;color:var(--acu-plum);font-variant-numeric:tabular-nums}
.studio-result-controls {display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:14px;font-size:12px}
.studio-result-controls button,.studio-inspection button,.studio .contribution-map-toolbar button {font:inherit;font-size:12px;color:var(--acu-plum);padding:5px 9px;background:var(--acu-ivory);border:1px solid var(--line);border-radius:4px;cursor:pointer}
.studio-result-controls button:disabled,.studio-inspection button:disabled {opacity:.5;cursor:default}
.studio-result-controls span {flex:1}
.studio-inspection {margin-top:18px;border-top:1px solid var(--line);padding-top:12px}
.studio-inspection .table-scroll {max-height:420px;font-size:11px;margin:10px 0}
.studio-inspection th,.studio-inspection td {min-width:90px;max-width:300px;overflow-wrap:anywhere;padding:7px}
.studio .contribution-map {width:100%;min-width:600px;font-size:11px}
.studio .contribution-map-toolbar {display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px}
.studio .contribution-map svg {width:100%;height:auto;max-height:720px;border:1px solid var(--line);touch-action:none}
.studio .contribution-map-coverage {font-weight:600;color:var(--acu-plum)}
.studio .contribution-map p {line-height:1.5;margin:8px 0;overflow-wrap:anywhere}
.studio .plot-mark {cursor:pointer}
.studio-canvas[aria-busy="true"] {opacity:.45;pointer-events:none}
.studio .plot-mark:focus {outline:none;stroke:var(--acu-purple);stroke-width:3}
.studio-canvas table {font-size:12px;width:100%;border-collapse:collapse}
.studio-canvas table th,.studio-canvas table td {padding:7px 10px;border-bottom:1px solid var(--line);text-align:left}
.studio-canvas table .numeric {text-align:right;font-variant-numeric:tabular-nums}
.studio-canvas .selectable {cursor:pointer}
.studio-canvas .selectable:hover {background:var(--acu-ivory)}
.studio-filter-editor small {display:block;max-width:240px;font-size:11px;color:var(--muted)}

#view-chart-studio { color: var(--acu-plum); font-family: var(--font-sans); }
.studio-comparison-toolbar,.studio-quick-tools {display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:10px;background:var(--acu-ivory)}
.studio-count-toggle {display:flex;flex-wrap:wrap;gap:4px}
.studio-comparison-toolbar button,.studio-quick-tools button,.studio-quick-tools select {font:inherit;padding:7px;border:1px solid var(--line);border-radius:5px;background:var(--acu-paper);color:var(--acu-plum)}
.studio-count-toggle [aria-pressed=true] {background:var(--acu-plum);color:var(--acu-paper)}
.studio-quick-tools label {display:flex;align-items:center;gap:6px;margin:0;min-width:0}
.studio-quick-tools select {max-width:240px}
.studio-filter-links label {display:inline-flex;gap:5px;margin:6px}
.studio-link-status {font-size:12px}
.studio-comparison-grid {display:grid;grid-template-columns:minmax(0,1fr);gap:12px;align-items:start}
.studio-comparison-grid[data-count="2"],.studio-comparison-grid[data-count="3"],.studio-comparison-grid[data-count="4"] {grid-template-columns:repeat(2,minmax(0,1fr))}
.studio-comparison-frame {display:block;width:100%;height:980px;border:1px solid var(--line);border-radius:8px;background:var(--acu-paper)}
.studio-comparison-frame[hidden] {display:none}
.studio-multi .studio-grid,.studio-embedded .studio-grid,.studio-options-hidden .studio-grid {grid-template-columns:minmax(0,1fr)!important;min-height:0}
.studio-multi .studio-side,.studio-multi .studio-cards,.studio-embedded .studio-side,.studio-embedded .studio-cards {max-height:300px;overflow:auto}
.studio-multi .studio-showme,.studio-embedded .studio-showme {width:auto}
.studio-options-hidden .studio-side,.studio-options-hidden .studio-cards,.studio-options-hidden .studio-showme,.studio-options-hidden .studio-shelf,.studio-options-hidden .studio-toolbar,.studio-options-hidden .studio-quick-tools label {display:none!important}
/* The control that put the builder away is the only way to bring it back,
   so it can never be part of what is put away. */
.studio-quick-tools {position:sticky;top:0;z-index:3}
.studio-options-hidden .studio-quick-tools,.studio-options-hidden .studio-options-restore {display:flex!important}
.studio-options-restore {font-weight:600;border-color:var(--acu-purple)!important}
.studio-embedded .app-navigation,.studio-embedded .workspace-heading,.studio-embedded .skip-link,.studio-embedded #workspace-main>.workspace>section:not(#view-chart-studio) {display:none!important}
.studio-embedded #workspace-main,.studio-embedded .workspace {margin:0;padding:0;max-width:none;width:100%;border:0}
.studio-embedded .studio {border:0;border-radius:0}
@media(max-width:850px){.studio-comparison-grid[data-count] {grid-template-columns:minmax(0,1fr)}}

.studio {
  display: flex;
  flex-direction: column;
  gap: 0;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--acu-paper);
  overflow: hidden;
}

/* ------------------------------------------------------------- toolbar */

.studio-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px;
  padding: 8px 10px;
  background: var(--acu-ivory);
  border-bottom: 1px solid var(--line);
}
.studio-toolbar button,
.studio-toolbar summary,
.studio-toolbar select {
  font: inherit;
  font-size: 12px;
  line-height: 1.2;
  color: var(--acu-plum);
  background: white;
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 6px 9px;
  cursor: pointer;
}
.studio-toolbar button:hover:not(:disabled),
.studio-toolbar summary:hover { border-color: var(--acu-purple); background: #f7f2fa; }
.studio-toolbar button:disabled { color: var(--muted); cursor: default; opacity: .55; }
.studio-toolbar button[aria-pressed=true] { background: var(--acu-gold); border-color: var(--acu-gold); font-weight: 600; }
.studio-toolbar .studio-toolbar-gap { flex: 1 1 auto; }
.studio-toolbar .studio-classic { border-style: dashed; }
.studio-menu { position: relative; }
.studio-menu > summary { list-style: none; display: inline-block; }
.studio-menu > summary::-webkit-details-marker { display: none; }
.studio-menu > div {
  position: absolute;
  z-index: 6;
  right: 0;
  margin-top: 4px;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 6px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 6px;
  box-shadow: 0 6px 18px rgba(52, 38, 73, .14);
}
.studio-menu button { white-space: nowrap; text-align: left; }

/* ---------------------------------------------------------------- grid */

.studio-grid {
  display: grid;
  grid-template-columns: 252px 190px minmax(320px, 1fr) auto;
  align-items: stretch;
  min-height: 560px;
}
.studio-grid > * { border-right: 1px solid var(--line); min-width: 0; }
.studio-grid > :last-child { border-right: 0; }

/* ------------------------------------------------------------- side bar */

.studio-side { background: var(--acu-ivory); display: flex; flex-direction: column; }
.studio-side-tabs { display: flex; border-bottom: 1px solid var(--line); }
.studio-side-tabs button {
  flex: 1;
  font: inherit;
  font-size: 12px;
  font-weight: 600;
  padding: 9px 6px;
  color: var(--muted);
  background: transparent;
  border: 0;
  border-bottom: 3px solid transparent;
  cursor: pointer;
}
.studio-side-tabs button[aria-selected=true] { color: var(--acu-plum); border-bottom-color: var(--acu-gold); }
.studio-pane { padding: 12px; overflow-y: auto; max-height: 70vh; }
.studio-pane h3 {
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 16px 0 6px;
  font-family: var(--font-sans);
  font-weight: 600;
}
.studio-pane h3:first-child { margin-top: 0; }
.studio-pane label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 8px; }
.studio-pane select,
.studio-pane input[type=text],
.studio-pane input[type=number],
.studio-pane input[type=search] {
  display: block;
  width: 100%;
  margin-top: 3px;
  font: inherit;
  font-size: 12px;
  color: var(--acu-plum);
  background: white;
  border: 1px solid #c6bab0;
  border-radius: 4px;
  padding: 5px 6px;
}
.studio-pane .studio-inline { display: flex; gap: 8px; }
.studio-pane .studio-inline > label { flex: 1; }
.studio-pane .studio-check { display: flex; align-items: center; gap: 6px; }
.studio-pane .studio-check input { width: auto; margin: 0; }
.studio-source { border-bottom: 1px solid var(--line); padding-bottom: 10px; margin-bottom: 10px; }
.studio-source p { margin: 0 0 8px; font-size: 11px; color: var(--muted); }
.studio-fields { display: flex; flex-direction: column; gap: 3px; }
.studio-fields:empty::after { content: 'No fields'; font-size: 11px; color: var(--muted); }

/* ---------------------------------------------------------------- pills */

.studio-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  max-width: 100%;
  font: inherit;
  font-size: 12px;
  line-height: 1.25;
  color: white;
  background: var(--acu-purple);
  border: 1px solid transparent;
  border-radius: 11px;
  padding: 4px 10px;
  cursor: grab;
  text-align: left;
}
.studio-pill.is-measure { background: var(--acu-teal); }
.studio-pill .studio-glyph { font-size: 10px; opacity: .85; font-weight: 600; letter-spacing: .04em; }
.studio-pill .studio-pill-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.studio-pill.is-selected { outline: 2px solid var(--acu-gold); outline-offset: 1px; }
.studio-pill:focus-visible { outline: 3px solid var(--acu-gold); outline-offset: 2px; }
.studio-pill[data-dragging=true] { opacity: .45; }
.studio-pill .studio-pill-menu {
  font: inherit;
  font-size: 11px;
  color: white;
  background: rgba(255, 255, 255, .18);
  border: 0;
  border-radius: 8px;
  padding: 1px 5px;
  cursor: pointer;
}
.studio-fields .studio-pill { width: 100%; }

/* ---------------------------------------------------------------- cards */

.studio-cards { background: var(--acu-ivory); padding: 12px; overflow-y: auto; max-height: 70vh; }
.studio-card { border: 1px solid var(--line); border-radius: 6px; background: white; padding: 8px; margin-bottom: 10px; }
.studio-card h3 {
  font-size: 11px;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 6px;
  font-weight: 600;
}
.studio-drop {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 4px;
  min-height: 30px;
  padding: 4px;
  border: 1px dashed var(--line);
  border-radius: 5px;
  background: var(--acu-paper);
}
.studio-drop.is-over { border-color: var(--acu-gold); background: #fdf5e4; }
.studio-drop:empty::after,
.studio-drop[data-empty=true]::after {
  content: attr(data-placeholder);
  font-size: 11px;
  color: var(--muted);
  padding: 3px 2px;
}
.studio-mark-props { display: grid; grid-template-columns: 1fr; gap: 6px; margin-top: 8px; }
.studio-prop { display: grid; grid-template-columns: 58px 1fr; gap: 6px; align-items: start; }
.studio-prop > span { font-size: 11px; color: var(--muted); padding-top: 6px; }
.studio-pager { display: flex; gap: 4px; align-items: center; margin-top: 6px; }
.studio-pager button { font: inherit; font-size: 11px; padding: 4px 7px; border: 1px solid var(--line); background: white; border-radius: 4px; cursor: pointer; }
.studio-pager span { font-size: 11px; color: var(--muted); }
.studio-filter-editor { margin-top: 6px; display: grid; gap: 4px; }
.studio-filter-editor select,
.studio-filter-editor input {
  font: inherit; font-size: 12px; padding: 4px 5px;
  border: 1px solid #c6bab0; border-radius: 4px; background: white; color: var(--acu-plum);
}
.studio-filter-editor .studio-editor-actions { display: flex; gap: 4px; }
.studio-filter-editor button { font: inherit; font-size: 11px; padding: 4px 7px; border: 1px solid var(--line); background: white; border-radius: 4px; cursor: pointer; }

/* ----------------------------------------------------------------- view */

.studio-view { display: flex; flex-direction: column; background: white; min-width: 0; }
.studio-shelf { display: flex; align-items: flex-start; gap: 8px; padding: 6px 10px; border-bottom: 1px solid var(--line); }
.studio-shelf-name { flex: 0 0 62px; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding-top: 8px; }
.studio-shelf .studio-drop { flex: 1; border-style: solid; border-color: transparent; background: transparent; }
.studio-shelf .studio-drop.is-over { border-color: var(--acu-gold); background: #fdf5e4; }
.studio-canvas-wrap { flex: 1; padding: 12px 14px 16px; overflow: auto; min-width: 0; }
.studio-canvas-wrap h2 { font-family: var(--font-serif); font-weight: 400; font-size: 21px; margin: 0 0 2px; }
.studio-note { font-size: 11px; color: var(--muted); margin: 0 0 8px; }
.studio-canvas { overflow: auto; }
.studio-canvas svg { display: block; max-width: 100%; height: auto; background: white; }
.studio-canvas.fit-width svg { width: 100%; max-width: none; }
.studio-canvas.fit-entire svg { width: 100%; max-width: none; max-height: calc(100vh - 430px); }
.studio-canvas:empty { min-height: 220px; background: repeating-linear-gradient(0deg, var(--acu-paper), var(--acu-paper) 49px, var(--line) 50px); }
.studio-table table { width: 100%; border-collapse: collapse; font-size: 12px; }
.studio-table th, .studio-table td { border-bottom: 1px solid #eee6df; padding: 5px 8px; text-align: left; }
.studio-table th { background: var(--acu-paper); font-weight: 600; position: sticky; top: 0; }
.studio-datasource { padding: 14px 16px; background: white; }
.studio-datasource table { width: 100%; border-collapse: collapse; font-size: 12px; }
.studio-datasource th, .studio-datasource td { border-bottom: 1px solid #eee6df; padding: 5px 8px; text-align: left; }
.studio-datasource th { background: var(--acu-paper); font-weight: 600; }
.studio-datasource dl { display: grid; grid-template-columns: 150px 1fr; gap: 4px 12px; font-size: 12px; margin: 0 0 16px; }
.studio-datasource dt { color: var(--muted); }
.studio-datasource dd { margin: 0; word-break: break-all; }

/* -------------------------------------------------------------- show me */

.studio-showme { width: 268px; background: var(--acu-ivory); display: flex; flex-direction: column; }
.studio-showme[hidden] { display: none; }
.studio-showme-head { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; border-bottom: 1px solid var(--line); }
.studio-showme-head h3 { margin: 0; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.studio-showme-head button { font: inherit; font-size: 11px; border: 1px solid var(--line); background: white; border-radius: 4px; padding: 3px 7px; cursor: pointer; }
.studio-showme-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 8px; overflow-y: auto; }
.studio-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  aspect-ratio: 1 / 1;
  font: inherit;
  font-size: 9px;
  line-height: 1.15;
  text-align: center;
  color: var(--acu-plum);
  background: white;
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 3px;
  cursor: pointer;
}
.studio-tile svg { width: 32px; height: 26px; }
.studio-tile:disabled { color: var(--muted); background: var(--acu-paper); cursor: default; opacity: .5; }
.studio-tile.is-recommended { outline: 2px solid var(--acu-gold); outline-offset: -1px; }
.studio-tile[aria-pressed=true] { border-color: var(--acu-purple); background: #f3eef8; }
.studio-showme-foot { margin: 0; padding: 8px 10px; border-top: 1px solid var(--line); font-size: 11px; color: var(--muted); min-height: 46px; }

/* ------------------------------------------------------- sheets + status */

.studio-sheets { display: flex; align-items: center; gap: 4px; padding: 6px 10px; background: var(--acu-ivory); border-top: 1px solid var(--line); overflow-x: auto; }
.studio-sheets button {
  font: inherit;
  font-size: 12px;
  color: var(--acu-plum);
  background: white;
  border: 1px solid var(--line);
  border-bottom: 3px solid transparent;
  border-radius: 5px 5px 0 0;
  padding: 6px 11px;
  cursor: pointer;
  white-space: nowrap;
}
.studio-sheets button[aria-selected=true] { border-bottom-color: var(--acu-gold); font-weight: 600; }
.studio-sheets .studio-sheet-tabs { display: flex; gap: 4px; }
.studio-sheets input {
  font: inherit; font-size: 12px; padding: 5px 8px;
  border: 1px solid var(--acu-purple); border-radius: 5px; background: white; color: var(--acu-plum);
}
.studio-status {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 14px;
  padding: 7px 12px;
  background: white;
  border-top: 1px solid var(--line);
  font-size: 11px;
  color: var(--muted);
}
.studio-status .studio-local { color: var(--acu-plum); font-weight: 600; letter-spacing: .04em; }

/* ------------------------------------------------------------- send menu */

.studio-send {
  position: absolute;
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 6px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 6px;
  box-shadow: 0 6px 18px rgba(52, 38, 73, .16);
}
.studio-send button {
  font: inherit; font-size: 12px; text-align: left; white-space: nowrap;
  border: 0; background: transparent; color: var(--acu-plum); padding: 5px 10px; border-radius: 4px; cursor: pointer;
}
.studio-send button:hover, .studio-send button:focus-visible { background: #f3eef8; }

/* -------------------------------------------------------------- analytics */

.studio-analytics-item {
  display: block;
  width: 100%;
  font: inherit;
  font-size: 12px;
  text-align: left;
  color: var(--acu-plum);
  background: white;
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 6px 9px;
  margin-bottom: 4px;
  cursor: grab;
}
.studio-analytics-item[aria-pressed=true] { background: var(--acu-gold); border-color: var(--acu-gold); font-weight: 600; }
.studio-analytics-item small { display: block; color: var(--muted); font-size: 10px; margin-top: 2px; }
.studio-analytics-item[aria-pressed=true] small { color: var(--acu-plum); }

/* ------------------------------------------------------------ responsive */

@media (max-width: 1400px) {
  .studio-grid { grid-template-columns: 232px 178px minmax(280px, 1fr); }
  .studio-showme { grid-column: 1 / -1; width: auto; border-top: 1px solid var(--line); }
  .studio-showme-grid { grid-template-columns: repeat(8, 1fr); }
}
@media (max-width: 1000px) {
  .studio-grid { grid-template-columns: 1fr; }
  .studio-grid > * { border-right: 0; border-bottom: 1px solid var(--line); }
  .studio-pane, .studio-cards { max-height: none; }
  .studio-showme-grid { grid-template-columns: repeat(4, 1fr); }
}
@media (prefers-reduced-motion: reduce) { .studio * { transition: none !important; } }
.studio-source-choices,.studio-model-tables{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0}.studio-model-tables section{flex:1 1 240px;border:1px solid var(--line,#d8d0df);border-radius:6px;padding:12px;background:var(--surface,#fff)}.studio-model-tables h4{margin:0 0 8px}.studio-model-tables p{margin:0 0 8px}.studio-datasource table{min-width:850px}.studio-datasource{overflow:auto}
