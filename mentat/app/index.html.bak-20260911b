<p id="flow-status" role="status"></p><div id="flow-preview" class="flow-preview"></div><div id="flow-table" class="table-scroll"></div><p id="flow-note" class="chart-note"></p>
</section>
<details><summary>Compare overall subject totals</summary><div class="compare-tools"><label for="compare-kind">Subject type<select id="compare-kind"><option value="">All subjects</option><option>Industry</option><option>Company</option><option>Person</option><option>Recipient</option><option>Candidate</option></select></label><label for="compare-search">Search subjects<input id="compare-search" type="search" placeholder="Name, company or candidate"></label></div><p id="compare-status" class="muted" role="status"></p><div class="compare-tools"><label for="compare-cycle">Compare cycle<select id="compare-cycle"></select></label><button id="compare-chart" type="button" class="secondary">Chart these subjects</button><button id="compare-export" type="button" class="secondary">Export comparison CSV</button><button id="compare-clear" type="button" class="secondary">Clear comparison</button></div>
