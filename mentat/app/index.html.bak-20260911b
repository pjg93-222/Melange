<div class="compare-tools"><label>Show<select id="flow-mode"><option value="Candidate">Candidates</option><option value="Recipient">Recipient committees</option></select></label><label>Find receiver type<select id="flow-category"><option value="">All receiver types</option></select></label><label>Election cycle<select id="flow-cycle"></select></label></div>
<div class="flow-pickers"><section><label>Find companies or PACs<input id="flow-source-search" type="search" placeholder="Search name or committee ID"></label><label>Source type<select id="flow-source-type"><option value="">All companies and committees</option></select></label><div id="flow-sources" class="flow-choices" aria-label="Funding sources"></div><div id="flow-source-picks" class="flow-picks"></div></section><section><label>Find candidates or recipients<input id="flow-target-search" type="search" placeholder="Search name or candidate ID"></label><button id="flow-select-matches" class="secondary" type="button">Select matching recipients</button><div id="flow-targets" class="flow-choices" aria-label="Funding recipients"></div><div id="flow-target-picks" class="flow-picks"></div></section></div>
<div id="flow-channels" class="flow-picks" aria-label="Included activity"></div>
