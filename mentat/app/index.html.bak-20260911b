<section id="graph-organization-panel" class="panel" hidden><div class="panel-heading"><h2>Top organizations</h2><button class="graph-text-button" data-values="organizations" type="button">View all →</button></div><p class="muted">Select a recipient to narrow the scope.</p><div id="graph-organizations"></div></section>
<section id="graph-candidate-panel" class="panel graph-candidate-panel"><div class="panel-heading"><h2>Top candidates</h2><button id="graph-view-candidates" class="graph-text-button" type="button">View all →</button></div>
<div id="graph-candidate-controls" class="graph-candidate-controls" hidden><label for="graph-mode">Candidate view<select id="graph-mode"><option value="direct">Direct contributions</option><option value="activity">Downstream PAC activity</option><option value="estimates">Conditional industry estimates</option></select></label><label for="graph-direction" hidden>Direction<select id="graph-direction"><option value="Support">Support</option><option value="Oppose">Opposition</option><option value="Contribution / Other">Contributions / other activity</option><option value="Unknown">Unknown direction</option></select></label></div>
<p id="graph-candidate-note" class="chart-note"></p><p id="graph-unresolved" class="chart-note"></p><div id="graph-candidates"></div>
