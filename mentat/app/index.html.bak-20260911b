<details id="graph-candidate-detail" hidden><summary id="graph-candidate-detail-title">Candidate receipt groups</summary><div class="table-scroll"><table><thead><tr><th>Company</th><th>Level</th><th>Recipient / source committee</th><th>Cycle</th><th>Amount</th></tr></thead><tbody id="graph-candidate-rows"></tbody></table></div></details></section>
<section class="panel" id="graph-company-panel" hidden><div class="panel-heading"><h2>Company comparison</h2><button class="graph-text-button" data-values="companies" type="button">View all →</button></div><p class="muted">Select a company to explore its giving.</p><div id="graph-companies"></div></section>
<section class="panel" id="graph-level-panel" hidden><div class="panel-heading"><h2>Giving by employee level</h2></div><p class="chart-note">Personal giving in the selected scope. Corporate giving is separate.</p><div id="graph-levels"></div></section>
</div></div>
<div class="graph-details-tools"><details id="graph-method-details"><summary>Details &amp; methodology</summary><p id="graph-method" class="muted"></p><p class="muted">Chart images export the displayed preview. CSV includes every value in the selected breakdown.</p></details><div class="graph-export-tools"><label class="sr-only" for="graph-export-target">Chart to export</label><select id="graph-export-target"><option value="categories">Recipient types</option><option value="organizations">Organizations</option><option value="candidates">Candidates</option><option value="companies">Companies</option><option value="levels">Employee levels</option></select><button id="graph-full-table" class="graph-text-button" type="button">Full table</button><label class="sr-only" for="graph-export-format">Export format</label><select id="graph-export-format"><option value="png">PNG image</option><option value="svg">SVG image</option><option value="csv">CSV data</option></select><button id="graph-export" class="secondary" type="button">Export chart</button></div></div>
</div>
