<div class="graph-metrics"><div><span>Net giving in selected scope</span><strong id="graph-total">—</strong></div><div><span>Direct to candidates</span><strong id="graph-direct">—</strong><small id="graph-direct-share"></small></div><div><span>Recipient organizations</span><strong id="graph-recipient-count">—</strong><small id="graph-organization-share"></small></div></div>
