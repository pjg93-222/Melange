        if(result.type==='area')add('polygon',{points:`${x(0)},${y(0)} `+groups.map((g,i)=>`${x(i)},${y(g.value)}`).join(' ')+` ${x(groups.length-1)},${y(0)}`,fill:palette[0],'fill-opacity':.16});
        if (['line','area'].includes(result.type)) add('polyline',{points:groups.filter(g=>!g.forecast).map((g,i)=>`${x(i)},${y(g.value)}`).join(' '),fill:'none',stroke:palette[0],'stroke-width':2});
        const firstForecast=groups.findIndex(g=>g.forecast);if(firstForecast>0)add('polyline',{points:groups.slice(firstForecast-1).map((g,i)=>`${x(firstForecast-1+i)},${y(g.value)}`).join(' '),fill:'none',stroke:palette[0],'stroke-width':2,'stroke-dasharray':'7 5'});
        if(result.type==='pareto'){let running=0;const total=groups.reduce((n,g)=>n+g.value,0);add('polyline',{points:groups.map((g,i)=>{running+=g.value;return `${x(i)},${430-running/total*335}`;}).join(' '),fill:'none',stroke:palette[1],'stroke-width':3});label(920,78,'Cumulative 0–100%',{'text-anchor':'end'});}
        groups.forEach((g,i)=>{
          const color=palette[i%palette.length];
          if(isBox){
            add('line',{x1:x(i),x2:x(i),y1:y(g.low),y2:y(g.high),stroke:color,'stroke-width':2});
            for(const v of [g.low,g.high])add('line',{x1:x(i)-width/3,x2:x(i)+width/3,y1:y(v),y2:y(v),stroke:color,'stroke-width':2});
            tooltip(add('rect',{x:x(i)-width/2,y:y(g.q3),width,height:Math.max(1,y(g.q1)-y(g.q3)),fill:color,'fill-opacity':.25,stroke:color}),`${g.label}: median ${fmt(g.median)}, Q1 ${fmt(g.q1)}, Q3 ${fmt(g.q3)}, n=${g.n}`);
            add('line',{x1:x(i)-width/2,x2:x(i)+width/2,y1:y(g.median),y2:y(g.median),stroke:color,'stroke-width':3});
            g.outliers.forEach(v=>tooltip(add('circle',{cx:x(i),cy:y(v),r:3,fill:color}),`${g.label}: ${fmt(v)} (outlier)`));
          }else if(waterfall){const w=waterfall[i];tooltip(add('rect',{x:x(i)-width/2,y:Math.min(y(w.start),y(w.end)),width,height:Math.max(1,Math.abs(y(w.start)-y(w.end))),fill:g.value<0?palette[1]:palette[0]}),`${g.label}: ${fmt(g.value)}; running total ${fmt(w.end)}`);
          }else if(['line','area'].includes(result.type)) tooltip(add('circle',{cx:x(i),cy:y(g.value),r:4,fill:g.forecast?'white':palette[0],stroke:palette[0]}),`${g.forecast?'Same-phase baseline ':g.partial?'Partial period ':''}${g.label}: ${fmt(g.value)}${g.forecast_basis_year?`; based on ${g.forecast_basis_year}`:''}`);
          else tooltip(add('rect',{x:x(i)-width/2,y:Math.min(y(0),y(g.value)),width,height:Math.max(1,Math.abs(y(0)-y(g.value))),fill:color}),`${g.label}: ${fmt(g.value)}`);
          if(i % Math.max(1,Math.ceil(groups.length/8)) === 0){
            const displayLabel=result.type==='histogram'?g.label.split(' – ').map(value=>Number(value).toLocaleString('en-US',{maximumSignificantDigits:6})).join(' – '):g.label;
            const node=wrapped(x(i),453,displayLabel,16,2,{'text-anchor':'middle','data-category-label':'true'});
            if(result.type==='histogram')node.querySelector('title').textContent=g.label;
          }
        });
        wrapped(510,515,xTitle,85,2,{'text-anchor':'middle','data-axis-title':'x'});
        if(groups.length>8)label(100,574,`${groups.length} groups plotted; selected axis labels shown. Full labels and values are in the table and CSV.`);
      }
    }
    return {svg,plot};
  }
  function draw(result, measure) {
    el('image').replaceChildren(chartSVG(result,measure,chartConfig,data,el('title').textContent,el('scope').textContent).svg);
  }
  function tableRows(result=chart, config=chartConfig, source=data) {
    const grouping=result.groupingLabel||columnLabel(config.x,source);
    if(result.series)return [[grouping,...result.series.map(name=>`${name} · ${measureLabel(config,result,source)}`)],...result.groups.map(g=>[g.label,...g.values.map(v=>v.value??'Unavailable')])];
    if (result.type === 'scatter') return [[columnLabel(config.x,source),columnLabel(config.y,source)], ...result.points.map(p=>[p.x,p.y])];
    if (result.type === 'box') return [[grouping,'Count',`Q1 · ${measureLabel(config,result,source)}`,`Median · ${measureLabel(config,result,source)}`,`Q3 · ${measureLabel(config,result,source)}`,'Lower whisker','Upper whisker','Outliers'],...result.groups.map(g=>[g.label,g.n,g.q1,g.median,g.q3,g.low,g.high,g.outliers.join('; ')])];
    return [[result.type==='histogram'?`${columnLabel(config.y,source)} · range`:grouping,result.type==='histogram'?'Row count':measureLabel(config,result,source),...(result.temporal?['Status','Baseline period']:[])],...result.groups.map(g=>[g.label,g.value,...(result.temporal?[g.forecast?'Same-phase baseline':g.partial?'Partial observation':'Observed / derived',g.forecast_basis_year??'']:[])])];
  }
