def console_busy(app):
    """Whether this console owns work a restart would interrupt.

    A console that cannot answer is reported busy: never stop work on a guess.
    """
    reader = getattr(app, 'busy', None)
    if not callable(reader):
        return False
    try:
        return bool(reader())
    except Exception:
        return True


