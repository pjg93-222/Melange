def accepts_gzip(header):
    for entry in (header or '').split(','):
        parts = [part.strip() for part in entry.lower().split(';')]
        if parts[0] != 'gzip':
            continue
        try:
            return all(float(part[2:]) > 0 for part in parts[1:] if part.startswith('q='))
        except ValueError:
            return False
    return False


