/* Up to four isolated Chart Studio instances. No chart state or query result is
   shared; linked filters are translated by field ID, never by column position. */
(()=>{
  'use strict';
  const root=document.getElementById('view-chart-studio'),studio=root.querySelector('.studio');
  // A pane only behaves as a pane while it really is framed. Opened as a
  // top-level tab it keeps the whole console, so there is always a way back.
  const paneId=new URLSearchParams(location.search).get('studioPane')||'';
  const framed=(()=>{try{return window.top!==window.self;}catch{return true;}})();
  const embedded=/^[BCD]$/.test(paneId)&&framed;
  const button=(label,action)=>{const b=document.createElement('button');b.type='button';b.textContent=label;b.onclick=action;return b;};
  let hidden=false;
  const api=window.MentatStudioPane;
  const quick=document.createElement('div');quick.className='studio-quick-tools';
  const name=document.createElement('span');name.className='studio-pane-tag';name.textContent='Chart '+(embedded?paneId:'A');quick.append(name);
  const mark=document.getElementById('studio-mark').closest('label');mark.firstChild.textContent='Chart variant';quick.append(mark);
  (document.getElementById('studio-shelves')||document.getElementById('studio-canvas-wrap')).before(quick);
  // The header's Builder | Canvas only control is the one visible switch. This
  // stays as the pane API the grid calls, so every pane moves together.
  function setOptions(value){hidden=!!value;
    if(api&&api.setOptionsHidden)api.setOptionsHidden(hidden);else studio.classList.toggle('studio-options-hidden',hidden);
    window.dispatchEvent(new Event('mentat:studio-options'));}
  if(api)api.options=setOptions;
  if(embedded){
    document.body.classList.add('studio-embedded');
    if(typeof showView==='function')showView('chart-studio');
    return;
  }
  const key='mentat-chart-comparison-v1';let saved={};try{saved=JSON.parse(localStorage.getItem(key)||'{}');}catch{}
  const state={count:[1,2,3,4].includes(saved.count)?saved.count:1,hidden:!!saved.hidden,links:Array.isArray(saved.links)?saved.links.filter(f=>['company','party','state','recipient_state','represented_state'].includes(f)):['company']};
  const persist=()=>{try{localStorage.setItem(key,JSON.stringify(state));}catch{}};
  const toolbar=document.createElement('div');toolbar.className='studio-comparison-toolbar';toolbar.setAttribute('aria-label','Chart comparison layout');
  const group=document.createElement('div');group.className='studio-count-toggle';group.setAttribute('role','group');group.setAttribute('aria-label','Number of charts');
  for(let n=1;n<=4;n++){const b=button(n+' chart'+(n===1?'':'s'),()=>{state.count=n;persist();render();});b.dataset.count=n;group.append(b);}toolbar.append(group);
  const allOptions=button('',()=>{state.hidden=!state.hidden;persist();render();});toolbar.append(allOptions);
  const links=document.createElement('details');links.className='studio-filter-links';const title=document.createElement('summary');title.textContent='Linked filters';links.append(title);
  for(const [field,label]of [['company','Company'],['party','Party'],['state','Contributor state'],['recipient_state','Recipient committee state'],['represented_state','Candidate represented state']]){
    const labelNode=document.createElement('label'),check=document.createElement('input');check.type='checkbox';check.checked=state.links.includes(field);check.dataset.field=field;
    check.onchange=()=>{state.links=check.checked?[...state.links,field]:state.links.filter(f=>f!==field);persist();if(check.checked)sync(window,[field]);};labelNode.append(check,document.createTextNode(label));links.append(labelNode);
  }toolbar.append(links);
  const overviewToggle=document.getElementById('studio-overview-toggle');if(overviewToggle)toolbar.append(overviewToggle);
  const note=document.createElement('span');note.className='studio-link-status';note.setAttribute('role','status');toolbar.append(note);
  const grid=document.createElement('div');grid.id='studio-comparison-grid';grid.className='studio-comparison-grid';studio.before(toolbar,grid);grid.append(studio);
  const frames=new Map(),blocked=new Set();
  // Reading any property of a frame the browser refused to load throws a
  // SecurityError, so every pane access goes through here.
  const paneOf=frame=>{try{return frame.contentWindow?.MentatStudioPane||null;}catch{blocked.add(frame.dataset.pane);return null;}};
  const windows=()=>[window,...[...frames.values()].filter(f=>!f.hidden&&!blocked.has(f.dataset.pane)).map(f=>{try{return f.contentWindow;}catch{return null;}}).filter(Boolean)];
  let syncing=false;
  function sync(source,fields=state.links){
    if(syncing||!source.MentatStudioPane?.ready()||!windows().includes(source))return;syncing=true;const missed=new Set();
    try{for(const target of windows())if(target!==source&&target.MentatStudioPane?.ready())for(const f of target.MentatStudioPane.applyFilters(source.MentatStudioPane.filters(),fields))missed.add(f);}
    finally{syncing=false;}
    note.textContent=missed.size?'Some linked fields are unavailable in another chart.':'';
  }
  function listen(win){let previous='',initialized=false;win.addEventListener('mentat:studio-state',()=>{if(!win.MentatStudioPane?.ready())return;if(!initialized){initialized=true;if(win!==window)sync(window);}const value=JSON.stringify(win.MentatStudioPane.filters().filter(f=>state.links.includes(f.field)));if(value!==previous){previous=value;if(!syncing)sync(win);}});}
  listen(window);
  function render(){
    grid.dataset.count=state.count;studio.classList.toggle('studio-multi',state.count>1);group.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.count)===state.count)));
    allOptions.textContent=state.hidden?'Builder in every chart':'Canvas only in every chart';allOptions.setAttribute('aria-expanded',String(!state.hidden));setOptions(state.hidden);
    for(let i=1;i<4;i++){
      const id='BCD'[i-1];let frame=frames.get(id);
      if(i<state.count&&!frame){frame=document.createElement('iframe');frame.title='Chart '+id;frame.className='studio-comparison-frame';frame.dataset.pane=id;
        const url=new URL(location.href);url.searchParams.set('studioPane',id);url.hash='chart-studio';frame.src=url.href;
        frame.onload=()=>{const pane=paneOf(frame);
          if(!pane){report();return;}
          blocked.delete(id);const win=frame.contentWindow;pane.options(state.hidden);listen(win);sync(window);
          const content=win.document.querySelector('.studio');if(content){const resize=new win.ResizeObserver(()=>{if(!frame.hidden)frame.style.height=Math.max(420,Math.ceil(content.getBoundingClientRect().height)+4)+'px';});resize.observe(content);}
        };frames.set(id,frame);grid.append(frame);
      }
      if(frame){frame.hidden=i>=state.count;paneOf(frame)?.options(state.hidden);}
    }
    sync(window);report();
  }
  function report(){
    const names=[...blocked].sort();
    note.textContent=names.length
      ? 'Chart '+names.join(', ')+' could not open in this page. The console is refusing to embed itself; restart the console so it allows its own comparison panes.'
      : note.textContent;
  }
  render();
})();
