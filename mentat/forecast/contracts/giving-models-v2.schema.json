{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "giving-models-v2.schema.json",
  "title": "Giving Forecast model bundle v2",
  "description": "The refit pipeline writes it; the console calculator reads it (DE-021: one fixture, both lanes).",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "built_on": {
      "$ref": "#/$defs/date"
    },
    "built_at_utc": {
      "$ref": "#/$defs/utc"
    },
    "previous_model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "type": "object",
      "properties": {
        "pipeline": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "R_version": {
          "type": "string"
        },
        "packages": {
          "$ref": "#/$defs/string_map"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "pipeline",
        "run_id",
        "code_sha256",
        "R_version",
        "packages"
      ],
      "additionalProperties": false
    },
    "currency": {
      "type": "string"
    },
    "deflator": {
      "type": "object",
      "properties": {
        "series": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "base_year": {
          "type": "integer"
        },
        "cycle_rule": {
          "type": "string"
        }
      },
      "required": [
        "series",
        "source",
        "base_year",
        "cycle_rule"
      ],
      "additionalProperties": false
    },
    "inference": {
      "type": "string"
    },
    "validation": {
      "type": "string"
    },
    "interval_labels": {
      "type": "object",
      "properties": {
        "coefficient": {
          "type": "string"
        },
        "prediction": {
          "type": "string"
        }
      },
      "required": [
        "coefficient",
        "prediction"
      ],
      "additionalProperties": false
    },
    "anchor_contract": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "anchors_file_schema": {
          "const": "giving-anchors-v1"
        },
        "pac": {
          "type": "object",
          "properties": {
            "model": {
              "const": "pac_model"
            },
            "change": {
              "const": "relative_log"
            },
            "anchor_cycle_rule": {
              "const": "previous_cycle"
            },
            "measures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "pac_to_candidates",
                      "general_giving"
                    ]
                  },
                  "anchor": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "anchor",
                  "label"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "description": "Mentat measures the PAC model is applied to, side by side."
            }
          },
          "required": [
            "model",
            "change",
            "anchor_cycle_rule",
            "measures"
          ],
          "additionalProperties": false
        },
        "share": {
          "type": "object",
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "change": {
              "const": "pp"
            },
            "anchor_cycle_rule": {
              "const": "previous_cycle"
            },
            "bases": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "employee_candidate",
                      "pac_candidate"
                    ]
                  },
                  "anchor": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "anchor",
                  "label"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "remainder_total_rule": {
              "type": "string"
            }
          },
          "required": [
            "models",
            "change",
            "anchor_cycle_rule",
            "bases",
            "remainder_total_rule"
          ],
          "additionalProperties": false
        },
        "lobbying": {
          "type": "object",
          "properties": {
            "model": {
              "const": "lobby_model.log_refit"
            },
            "change": {
              "const": "relative_log"
            },
            "anchor_year_rule": {
              "const": "latest_complete_year"
            },
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "enum": [
                      "income_total",
                      "expenses_total"
                    ]
                  },
                  "label": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            },
            "never_summed": {
              "const": true
            }
          },
          "required": [
            "model",
            "change",
            "anchor_year_rule",
            "series",
            "never_summed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "anchors_file_schema",
        "pac",
        "share",
        "lobbying"
      ],
      "additionalProperties": false
    },
    "industries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "opensecrets_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mentat_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "ibisworld_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "lobbyview_sector": {
            "type": [
              "string",
              "null"
            ]
          },
          "calculator": {
            "type": "boolean"
          },
          "growth_mean": {
            "type": [
              "number",
              "null"
            ]
          },
          "growth_sd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "growth_min": {
            "type": [
              "number",
              "null"
            ]
          },
          "growth_max": {
            "type": [
              "number",
              "null"
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/industry_history_row"
            }
          },
          "scope": {
            "type": "string"
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "pac": {
                "type": "boolean"
              },
              "control": {
                "type": "boolean"
              },
              "lobbying": {
                "type": "boolean"
              }
            },
            "required": [
              "pac",
              "control",
              "lobbying"
            ],
            "additionalProperties": false
          },
          "withheld": {
            "$ref": "#/$defs/string_map"
          },
          "growth_scaling_cycles": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "lobbying_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer"
                },
                "lobbying_real_2025_million": {
                  "type": "number",
                  "minimum": 0
                },
                "predicted_growth_pct": {
                  "type": "number"
                }
              },
              "required": [
                "year",
                "lobbying_real_2025_million",
                "predicted_growth_pct"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "code",
          "opensecrets_codes",
          "mentat_key",
          "ibisworld_code",
          "lobbyview_sector",
          "calculator",
          "growth_mean",
          "growth_sd",
          "growth_min",
          "growth_max",
          "history",
          "scope",
          "capabilities",
          "withheld",
          "growth_scaling_cycles",
          "lobbying_history"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "pac_model": {
      "type": "object",
      "properties": {
        "beta": {
          "type": "number"
        },
        "ordinary_se": {
          "type": "number",
          "minimum": 0
        },
        "ordinary_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critical_95": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "cycles": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "specification": {
          "type": "string"
        },
        "selection_repeated_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "formula": {
          "type": "string"
        },
        "industries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "residual_df": {
          "type": "integer",
          "minimum": 1
        },
        "residual_sd": {
          "type": "number",
          "minimum": 0
        },
        "slope_rule": {
          "enum": [
            "R0",
            "R1",
            "R2"
          ]
        },
        "slope_rule_reason": {
          "type": "string"
        },
        "tau2": {
          "type": "number",
          "minimum": 0
        },
        "Q": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "df_interaction": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "slopes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/slope_row"
          },
          "minProperties": 1
        },
        "anchor_rule": {
          "const": "previous_cycle"
        },
        "prediction": {
          "$ref": "#/$defs/prediction"
        },
        "evidence": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [
        "beta",
        "ordinary_se",
        "ordinary_p",
        "critical_95",
        "n",
        "cycles",
        "specification",
        "selection_repeated_p",
        "formula",
        "industries",
        "residual_df",
        "residual_sd",
        "slope_rule",
        "slope_rule_reason",
        "tau2",
        "Q",
        "k",
        "df_interaction",
        "slopes",
        "anchor_rule",
        "prediction",
        "evidence"
      ],
      "additionalProperties": false,
      "description": "Pooled values kept as in v1 (beta, ordinary_se, ordinary_p, critical_95); slopes[id].applied is what the calculator uses."
    },
    "share_models": {
      "type": "object",
      "properties": {
        "control_House": {
          "$ref": "#/$defs/share_model"
        },
        "control_Senate": {
          "$ref": "#/$defs/share_model"
        }
      },
      "required": [
        "control_House",
        "control_Senate"
      ],
      "additionalProperties": false,
      "description": "Only the two control models. Seats and the *_industry variants are not calculator models in v2."
    },
    "evidence_models": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/evidence_model"
      }
    },
    "lobby_model": {
      "type": "object",
      "properties": {
        "beta_million": {
          "type": "number"
        },
        "ordinary_se_million": {
          "type": "number",
          "minimum": 0
        },
        "ordinary_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critical_95": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "industry_pair_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "specification": {
          "type": "string"
        },
        "wild_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "CR2_p": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "formula": {
          "type": "string"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 1
        },
        "anchor_rule": {
          "const": "last_year"
        },
        "log_refit": {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string"
            },
            "unit": {
              "type": "string",
              "description": "Log points of the lobbying level per +1 pp of the change in predicted growth (dg)."
            },
            "beta": {
              "type": "number"
            },
            "se": {
              "type": "number",
              "minimum": 0
            },
            "ordinary_p": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "critical_95": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "residual_df": {
              "type": "integer",
              "minimum": 1
            },
            "n": {
              "type": "integer",
              "minimum": 2
            },
            "slope_rule": {
              "enum": [
                "R0",
                "R1",
                "R2"
              ]
            },
            "slopes": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/slope_row"
              },
              "minProperties": 1
            },
            "prediction": {
              "$ref": "#/$defs/prediction"
            },
            "provenance": {
              "type": "string"
            }
          },
          "required": [
            "formula",
            "unit",
            "beta",
            "se",
            "ordinary_p",
            "critical_95",
            "residual_df",
            "n",
            "slope_rule",
            "slopes",
            "prediction",
            "provenance"
          ],
          "additionalProperties": false,
          "description": "The relative (log) lobbying model the calculator applies to Melange-LDA levels."
        },
        "evidence": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [
        "beta_million",
        "ordinary_se_million",
        "ordinary_p",
        "critical_95",
        "n",
        "industry_pair_counts",
        "specification",
        "wild_p",
        "CR2_p",
        "formula",
        "years",
        "anchor_rule",
        "log_refit",
        "evidence"
      ],
      "additionalProperties": false,
      "description": "v1 dollar model kept as evidence (beta_million..CR2_p); log_refit is the calculator model."
    },
    "political_inputs": {
      "type": "object",
      "properties": {
        "market_rule": {
          "type": "string"
        },
        "primary_market": {
          "const": "polymarket"
        },
        "anchor_cycles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "current_control": {
                "type": "object",
                "properties": {
                  "House": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "Senate": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "House",
                  "Senate"
                ],
                "additionalProperties": false
              },
              "window": {
                "type": "object",
                "properties": {
                  "start": {
                    "$ref": "#/$defs/date"
                  },
                  "end": {
                    "$ref": "#/$defs/date"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "House": {
                "type": "object",
                "properties": {
                  "p_rep": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Mean P(Republican control) over the window, this market."
                  },
                  "market": {
                    "type": "string"
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expected_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Calendar days in the window."
                  },
                  "first_day": {
                    "$ref": "#/$defs/date"
                  },
                  "partial_window": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "p_rep",
                  "market",
                  "days",
                  "expected_days",
                  "first_day",
                  "partial_window"
                ],
                "additionalProperties": false
              },
              "Senate": {
                "type": "object",
                "properties": {
                  "p_rep": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Mean P(Republican control) over the window, this market."
                  },
                  "market": {
                    "type": "string"
                  },
                  "days": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "expected_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Calendar days in the window."
                  },
                  "first_day": {
                    "$ref": "#/$defs/date"
                  },
                  "partial_window": {
                    "type": "boolean"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "p_rep",
                  "market",
                  "days",
                  "expected_days",
                  "first_day",
                  "partial_window"
                ],
                "additionalProperties": false
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string"
                    },
                    "sha256": {
                      "$ref": "#/$defs/sha256"
                    },
                    "market": {
                      "type": "string"
                    },
                    "chamber": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "file",
                    "sha256",
                    "market",
                    "chamber"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "current_control",
              "window",
              "House",
              "Senate",
              "sources"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^\\d{4}$"
          },
          "minProperties": 1
        }
      },
      "required": [
        "market_rule",
        "primary_market",
        "anchor_cycles"
      ],
      "additionalProperties": false,
      "description": "Expected-control inputs of anchor cycles that have no row in the model history (2024: Polymarket January-June only)."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    },
    "industry_slopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    },
    "validation_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      }
    },
    "backtests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "design": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "n": {
            "type": "integer"
          },
          "folds": {
            "type": "integer"
          },
          "targets": {
            "type": "string"
          },
          "MAE": {
            "type": "number"
          },
          "RMSE": {
            "type": "number"
          },
          "units": {
            "type": "string"
          },
          "coverage_95": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "beats_naive": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "model",
          "design",
          "path",
          "rule",
          "n",
          "folds",
          "targets",
          "MAE",
          "RMSE",
          "units",
          "coverage_95",
          "beats_naive"
        ],
        "additionalProperties": false
      }
    },
    "saved_outlook": {
      "type": "object",
      "properties": {
        "cycle": {
          "type": "integer"
        },
        "available_on": {
          "$ref": "#/$defs/date"
        },
        "control": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "House": {
              "$ref": "#/$defs/outlook_chamber"
            },
            "Senate": {
              "$ref": "#/$defs/outlook_chamber"
            }
          },
          "required": [
            "description",
            "House",
            "Senate"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cycle",
        "available_on",
        "control"
      ],
      "additionalProperties": false,
      "description": "2026 prefill for the console. Seats are not part of v2. value is the primary (Polymarket) score x100."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "pinned": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "member": {
            "type": [
              "string",
              "null"
            ]
          },
          "sheet": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "vintage": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "role",
          "file",
