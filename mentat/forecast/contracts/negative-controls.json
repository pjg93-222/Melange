{
  "note": "Shared negative controls (DE-021). Each control mutates the named example and MUST fail validation against its schema (kind 'schema') or the anchor invariants (kind 'invariant'). Apply them to the example, to a producer's real output, or both: a validator that accepts any of them is not checking what it claims to. ops: delete | set. A value {\"$nonfinite\": \"NaN\"} means a non-finite number (JSON cannot carry one): use the language's own NaN / Inf.",
  "controls": [
    {"id": "B01", "target": "models", "kind": "schema", "op": "delete", "path": ["anchor_contract"], "why": "the bundle must name which Mentat measure each model applies to"},
    {"id": "B02", "target": "models", "kind": "schema", "op": "set", "path": ["schema_version"], "value": 1, "why": "a v1 bundle is not a v2 bundle"},
    {"id": "B03", "target": "models", "kind": "schema", "op": "set", "path": ["pac_model", "beta"], "value": {"$nonfinite": "NaN"}, "why": "NaN / Inf are forbidden anywhere"},
    {"id": "B04", "target": "models", "kind": "schema", "op": "set", "path": ["share_models", "seats_House"], "value": {"id": "seats_House"}, "why": "seats are evidence only; a seat model in share_models is a calculator signal"},
    {"id": "B05", "target": "models", "kind": "schema", "op": "delete", "path": ["industries", "commercial_banks", "capabilities"], "why": "every industry declares its capabilities"},
    {"id": "B06", "target": "models", "kind": "schema", "op": "set", "path": ["share_models", "control_House", "anchor_rule"], "value": "same_phase_latest", "why": "shares carry over from Mentat's previous cycle (owner ruling 2026-09-30)"},
    {"id": "B07", "target": "models", "kind": "schema", "op": "set", "path": ["pac_model", "slopes", "commercial_banks", "applied", "critical_95"], "value": -1, "why": "a critical value is positive"},
    {"id": "B08", "target": "models", "kind": "schema", "op": "delete", "path": ["lobby_model", "log_refit"], "why": "the calculator applies a relative lobbying model"},
    {"id": "B09", "target": "models", "kind": "schema", "op": "set", "path": ["pac_model", "slopes", "credit_unions", "applied", "rule"], "value": "R9", "why": "the applied slope rule is R0, R1 or R2"},
    {"id": "B10", "target": "models", "kind": "schema", "op": "delete", "path": ["political_inputs", "anchor_cycles", "2024"], "why": "the 2024 control input has no row in the model history"},
    {"id": "B11", "target": "models", "kind": "schema", "op": "set", "path": ["pac_model", "ordinary_p"], "value": 1.5, "why": "a p-value lies in [0, 1]"},
    {"id": "B12", "target": "models", "kind": "schema", "op": "set", "path": ["industries", "credit_unions", "growth_sd"], "value": "19.9", "why": "numbers are numbers, not text"},
    {"id": "B13", "target": "models", "kind": "schema", "op": "set", "path": ["pac_model", "prediction", "industries"], "value": {}, "why": "a prediction interval needs a residual block for at least one industry"},
    {"id": "B14", "target": "models", "kind": "schema", "op": "set", "path": ["saved_outlook", "seats"], "value": {}, "why": "saved_outlook has no seats block in v2"},
    {"id": "B15", "target": "models", "kind": "schema", "op": "set", "path": ["evidence_models", "seats_House", "calculator"], "value": true, "why": "evidence models never feed the calculator"},
    {"id": "B16", "target": "models", "kind": "schema", "op": "set", "path": ["political_inputs", "anchor_cycles", "2024", "House", "days"], "value": 0, "why": "a market window has at least one day"}
  ]
}
