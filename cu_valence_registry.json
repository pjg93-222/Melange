    {"key": "cu_tax_status", "match": ["credit union tax", "cu tax exemption", "tax exempt status", "tax status of credit union"], "valence": 1, "rein_flips": true, "note": "protecting exemption = +1; attacks on it = -1"},
    {"key": "field_of_membership", "match": ["field of membership", "fom", "charter modernization", "charter expansion", "expanding membership"], "valence": 1, "rein_flips": false},
    {"key": "member_business_lending", "match": ["member business lending", "mbl cap", "business lending cap"], "valence": 1, "rein_flips": false, "note": "raising/removing the MBL cap = +1"},
    {"key": "cdfi_fund", "match": ["cdfi", "community development financial"], "valence": 1, "rein_flips": true, "note": "funding = +1; cuts = -1"},
    {"key": "defense_cu", "match": ["defense credit union", "military credit union", "on-base access", "morale welfare recreation banking"], "valence": 1, "rein_flips": false},
    {"key": "reg_relief", "match": ["regulatory relief", "reg relief", "tailoring", "regulatory burden", "right-size regulation"], "valence": 1, "rein_flips": false},
