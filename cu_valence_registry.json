    {"key": "fraud_prevention", "match": ["fraud prevention", "scam", "elder financial abuse", "authorized push payment"], "valence": 1, "rein_flips": false},
    {"key": "big_bank_favor", "match": ["too big to fail", "megabank bailout", "big bank charter", "wall street bank advantage"], "valence": -1, "rein_flips": true},
    {"key": "ncua_funding", "match": ["ncua budget", "share insurance fund", "ncua"], "valence": 0, "rein_flips": false, "note": "usually neutral/administrative; set per-context if a target emerges"}
