# --- secrets (never track) ---
fec/govinfo_key.txt
*.key

# --- data artifacts: generated/derived, regenerable from pipeline ---
*.json
*.jsonl
*.csv
*.tab
*.bak
fec/liwc/rkh/
fec/liwc/bl2025/
*.db
*.db-wal
*.db-shm
*.pkl
*.wav
audio_pilot/
*.xlsx
*.html
# The Mentat console page is rendered from these partials. Ignoring them left
# commit 991b06568 with a root template whose nine includes were not in the repo.
!mentat/app/templates/*.html
*.txt
_stance_ft/
stance_ft_composed/
backups/
archive/
baseline/
deploy/
.claude/*

# --- keep: code, docs, config, small source-of-truth text ---
!*.md
!formal_visibility_roles.json
!tweet_image_annotations.json
!tier_overrides.json
!requirements*.txt
!quorum_query.txt
!fec/retiring_members.txt
!.claude/launch.json
!.mcp.json

# python bytecode (mistakenly tracked in baseline)
__pycache__/
*.pyc

# track project slash commands + exclude logs
!.claude/commands/
!.claude/commands/*.md

# track the skill library (16-skill handoff library, 2026-07-10)
!.claude/skills/
!.claude/skills/**
*.log
fec/lep/
fec/votesmart_api_key.txt
!source_data/interview_n_affective.json
!source_data/wj_n_labels.json

# hand-curated hearings media map (config, not data)
!hearings_media_map.csv

# RStudio per-user state
.Rproj.user

# mentat data planes (inputs are 373M of FEC bulk + xlsx; caches/backups regenerable)
mentat/inputs/
mentat/.cache/
mentat-backup-*/
.agents/

# Contribution Studio source and regenerable analytical caches
!mentat/app/contribution-studio.html
mentat/state/contribution-analytics/
mentat/state/geography/
mentat/state/contribution-source-proofs/

# Mentat Pocket page template and the vendored PptxGenJS bundle
!mentat/tools/pocket/*.html
!mentat/app/vendor/*.js

# Chart Studio HTTP contract: the worked example payloads both the python and the
# node suites read. Source of truth, not a regenerable artifact - without this the
# *.json sweep above would drop it and both suites would fail on a fresh checkout.
!mentat/app/studio-contract-examples.json

# --- Mentat working-tree hygiene (2026-09-18) ---
# Node dependency trees are never tracked, wherever they appear.
node_modules/
# Session scratch and the published-report plane. reports/README.md is tracked and stays so.
/.tmp/
/reports/*
!/reports/README.md
# Lane notes, probes and renders under outputs/ are tracked; bulk extracts are not.
/outputs/raw-contributions/
/outputs/**/*.ndjson
# Console and pipeline runtime state: caches, locks, run ledgers, accepted-source pointers.
# Tracked code reads it and it is backed up with the databases, but it is never versioned.
mentat/state/
# Dated backup copies a lane leaves beside a source. `*.bak` above does not match
# `name.ext.bak-20260914-E`.
*.bak-*
*.bak2-*
*.bak3-*
# Test scratch.
.pytest_cache/
mentat/test-results/

# The authoritative report directory setting. R/paths.R, tools/report_directory.py,
# app/Start-MentatApp.ps1 and tests/test_desktop_launcher.py all read it; without it a clean
# checkout cannot resolve the report folder and that test fails.
!mentat/config/report-directory.json
!mentat/config/attribution-policy.json
!mentat/app/tests/chart-engine-r3.golden.json
