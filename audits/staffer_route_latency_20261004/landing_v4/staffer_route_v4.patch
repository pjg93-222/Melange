+    assert [(e['seq'], e['status'], e.get('abandoned_before')) for e in state['earlier']] == [(1, 'abandoned', 'network_index')]
+    assert list(state['earlier'][0]['stages']) == ['work_index'], 'it had finished the stage it was in, and no more'
+    assert DEFAULT_KEY in new.closeness_routes.indexes and DEFAULT_KEY in old.closeness_routes.indexes
+    assert new.closeness_routes.indexes[DEFAULT_KEY] is not old.closeness_routes.indexes[DEFAULT_KEY], 'the new router has its own index'
