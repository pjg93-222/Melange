+    monkeypatch.setattr(live, 'load_inventory', lambda *args: {'nodes': {}, 'identity_aliases': {}, 'identity_groups': [], 'sources': []})
+    monkeypatch.setattr(live, 'load_identity_resolution', lambda *args: {'records': {}, 'candidate_groups': [], 'sources': [], 'counts': {}})
