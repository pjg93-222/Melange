+def exact_cost(case, path):
+    """Exact cost of a returned [start, ..., staff, SINK]."""
+    total = Fraction(0)
+    for a, b in zip(path[:-2], path[1:-1]):
+        total += Fraction(case.edges[tuple(sorted((a, b)))][0])
+    return total + Fraction(case.terminal[path[-2]])
