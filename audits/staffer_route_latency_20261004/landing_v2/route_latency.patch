+Searches are real AdvocacyRouter searches on tiny graphs. GateRouter holds a
+search open the way a long one is held open, and still honours cancellation.
+"""
+import http.client
+from http.server import ThreadingHTTPServer
+import json
+import random
+import threading
+import time
