+                                  'label': '2021 HON. TEST OFFICE', 'member_ids': [], 'committee_ids': [], 'policy_ids': []}
+    for person in ('person:gordon', 'person:stephanie'):
+        graph.nodes[person]['stints'][0]['status'] = 'current'
+    graph.reindex()
+    return graph
