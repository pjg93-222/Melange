+    router.office_index = {'office:x': {'id': 'office:x', 'label': 'Office X', 'records_through': '2021-01-01',
+        'roster': {p: {'title': 'Title ' + p, 'basis': 'current_profile'} for p in 'bc'}}}
+    return router
