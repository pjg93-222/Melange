+# ----------------------------------------------------------------------------- every key input
+
+def change_profile_revision(service, provider, patch):
+    provider.profile_revision = 'rev-2'
+
+
+def change_prefix(service, provider, patch):
+    provider.accepted_prefix_sha256 = 'prefix-2'
