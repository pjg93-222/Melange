+    for query in ('politico:u1', 'POLITICO:U1', '%20politico:u1%20', 'u1', 'U1'):
+        status, body = get(port, '/api/staffer-search?q=%s&limit=20' % query)
+        assert status == 200 and [n['label'] for n in body['nodes']] == ['Alan Turing'], (query, body['nodes'])
