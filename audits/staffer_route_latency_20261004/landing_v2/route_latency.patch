+            label = ident                                    # a raw id: reindex turns it into an unresolved name
+        node = {'id': ident, 'kind': kind, 'label': label, 'member_ids': [], 'aliases': []}
+        if rng.random() < .15:
+            node['aliases'] = [label_from(rng) for _ in range(rng.randint(1, 2))]
