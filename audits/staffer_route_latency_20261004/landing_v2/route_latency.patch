+        unresolved_seen += any(graph.nodes[i].get('name_status') == 'UNRESOLVED_SOURCE_NAME' for i in full)
+        removed_queries += bool(set(spec.old_full(query)) - set(full))
+        bio_whole += query.strip().casefold() in spec.bios
