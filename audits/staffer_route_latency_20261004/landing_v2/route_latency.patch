+class CountingLock:
+    """The service lock, counting how many times it is taken."""
+
+    def __init__(self, inner):
+        self.inner, self.holds = inner, 0
+
+    def __enter__(self):
+        self.inner.acquire()
+        self.holds += 1
+        return self
+
+    def __exit__(self, *exc):
+        self.inner.release()
+
+    def _is_owned(self):
+        return self.inner._is_owned()
+
