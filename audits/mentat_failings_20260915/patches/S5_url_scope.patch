+function stopServer(child) {
+  return withTimeout(new Promise(resolve => {
+    if (!child || child.exitCode !== null) { resolve(); return; }
+    child.once('exit', () => resolve());
+    child.kill();
+  }), 10000, 'stopServer()').catch(error => { console.error(error.message); });
+}
