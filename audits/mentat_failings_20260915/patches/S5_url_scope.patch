diff --git a/mentat/app/scope.js b/mentat/app/scope.js
new file mode 100644
index 000000000..80c3827c7
--- /dev/null
+++ b/mentat/app/scope.js
@@ -0,0 +1,162 @@
+/* The console's URL scope: the hash names the tab, the query string carries the
+   scope. Pure except for `location` and `history`, so node:test can drive it
+   with a fake pair. Contract: audits/mentat_failings_20260915/contracts/url_scope.json.
+
+   Tab switches stay on history.replaceState (Paul's ruling C, 2026-09-17).
+   pushState is never used here: Back does not step through tabs today and S5
+   does not change that. */
+(function (root) {
+  'use strict';
+
+  // Every key this module owns, in the order it serializes them. A scope built
+  // from nothing writes its keys in this order; a scope merged into a live
+  // query leaves the keys already there where they are.
+  const KEYS = ['industry', 'company', 'cycle', 'mode', 'direction', 'tier',
+    'funding', 'category', 'recipient', 'saved'];
+  // The #graph-mode option values, verbatim (index.html:105).
+  const MODES = ['direct', 'activity', 'estimates'];
+  // S6's pane model owns these. S5 never writes one and never removes one.
+  const RESERVED = ['evidence', 'id', 'committee', 'offset', 'limit'];
+
+  const CYCLE_REASON = 'cycle must be a four-digit election-cycle end year';
+  const MODE_REASON = 'mode must be one of ' + MODES.join(', ');
+  const SAVED_REASON = 'saved must be a 32-character hexadecimal saved-view id';
+  const BLANK_REASON = 'a blank value names no scope, so the key is dropped';
+
+  // A bad permalink still has to open its tab, so nothing in here throws: an
+  // unusable value is dropped from the scope and reported through invalid[].
+  function check(key, raw) {
+    const text = raw == null ? '' : String(raw);
+    if (!text) return {ok: false, value: text, reason: BLANK_REASON};
+    if (key === 'cycle' && !/^\d{4}$/.test(text)) return {ok: false, value: text, reason: CYCLE_REASON};
+    if (key === 'mode' && MODES.indexOf(text) < 0) return {ok: false, value: text, reason: MODE_REASON};
+    // The same rule server.py get_view() enforces, so the client never fires a
+    // saved-view request the console will answer 400 for.
+    if (key === 'saved' && !/^[a-f0-9]{32}$/.test(text)) return {ok: false, value: text, reason: SAVED_REASON};
+    return {ok: true, value: text};
+  }
+
+  function entries(search) {
+    const text = String(search == null ? '' : search).replace(/^[?]/, '');
+    // URLSearchParams decodes both %20 and '+', keeps duplicates, keeps order,
+    // and never throws on a malformed escape.
+    return text ? [...new URLSearchParams(text)] : [];
+  }
+
+  /* --------------------------------------------------------------- reading */
+
+  function parse(search) {
+    const scope = {invalid: []};
+    const seen = Object.create(null);
+    for (const [key, value] of entries(search)) {
+      if (KEYS.indexOf(key) < 0 || seen[key]) continue;
+      seen[key] = true;
+      const checked = check(key, value);
+      if (checked.ok) scope[key] = checked.value;
+      else scope.invalid.push({key: key, value: checked.value, reason: checked.reason});
+    }
+    return scope;
+  }
+
+  function read(search) {
+    if (search !== undefined) return parse(search);
+    const here = typeof location === 'undefined' ? null : location;
+    return parse(here ? here.search : '');
+  }
+
+  /* --------------------------------------------------------------- writing */
+
+  // Values are encodeURIComponent'd, keys are written plain. URLSearchParams
+  // .toString() would spell a space as '+', and a published label such as
+  // "Property & Casualty Insurance" has to survive a copied permalink.
+  const encode = value => encodeURIComponent(String(value == null ? '' : value));
+
+  function serialize(scope) {
+    const source = scope || {};
+    const parts = [];
+    for (const key of KEYS) {
+      if (!Object.prototype.hasOwnProperty.call(source, key)) continue;
+      const checked = check(key, source[key]);
+      if (checked.ok) parts.push(key + '=' + encode(checked.value));
+    }
+    return parts.join('&');
+  }
+
+  // Merge a partial scope into a live query string. An empty, null or
+  // undefined value removes its key; a value this module would refuse to read
+  // back removes it too, so the URL can never carry something read() rejects.
+  // Every other key in the query - studioPane, S6's reserved keys, anything a
+  // future session adds - is preserved untouched and keeps its place.
+  function merge(search, partial) {
+    const pairs = entries(search);
+    const changes = partial || {};
+    for (const key of Object.keys(changes)) {
+      if (KEYS.indexOf(key) < 0) continue;
+      const checked = check(key, changes[key]);
+      const at = pairs.findIndex(pair => pair[0] === key);
+      if (!checked.ok) {
+        for (let i = pairs.length - 1; i >= 0; i -= 1) if (pairs[i][0] === key) pairs.splice(i, 1);
+        continue;
+      }
+      if (at < 0) pairs.push([key, checked.value]);
+      else {
+        pairs[at] = [key, checked.value];
+        for (let i = pairs.length - 1; i > at; i -= 1) if (pairs[i][0] === key) pairs.splice(i, 1);
+      }
+    }
+    return pairs.map(pair => pair[0] + '=' + encode(pair[1])).join('&');
+  }
+
+  function notify(scope, options) {
+    const opts = options || {};
+    if (typeof opts.dispatch === 'function') { opts.dispatch(scope); return; }
+    const target = opts.target || root;
+    if (!target || typeof target.dispatchEvent !== 'function' || typeof CustomEvent !== 'function') return;
+    target.dispatchEvent(new CustomEvent('mentat:scope', {detail: scope}));
+  }
+
+  function write(partial, options) {
+    const opts = options || {};
+    const here = opts.location || (typeof location === 'undefined' ? null : location);
+    const past = opts.history || (typeof history === 'undefined' ? null : history);
+    if (!here) return read();
+    const before = String(here.search || '').replace(/^[?]/, '');
+    const after = merge(before, partial);
+    if (after === before || !past || typeof past.replaceState !== 'function') return parse(after);
+    const url = (here.pathname || '/') + (after ? '?' + after : '') + (here.hash || '');
+    // A document with an opaque origin (a page built by setContent, a sandboxed
+    // frame) refuses replaceState. Nothing changed, so nothing is announced.
+    try { past.replaceState(null, '', url); } catch (error) { return parse(before); }
+    const scope = parse(after);
+    notify(scope, opts);
+    return scope;
+  }
+
+  // The permalink for a view and a scope. Used by "Open in Chart Studio" and
+  // available to S6 for pane links.
+  function href(view, scope, base) {
+    const here = base === undefined ? (typeof location === 'undefined' ? null : location) : base;
+    const path = (here && here.pathname) || '/';
+    const query = serialize(scope);
+    return path + (query ? '?' + query : '') + (view ? '#' + String(view) : '');
+  }
+
+  function subscribe(fn, target) {
+    const host = target || root;
+    if (typeof fn !== 'function' || !host || typeof host.addEventListener !== 'function') {
+      return function () {};
+    }
+    const onScope = event => fn(event && event.detail ? event.detail : read());
+    const onPop = () => fn(read());
+    host.addEventListener('mentat:scope', onScope);
+    host.addEventListener('popstate', onPop);
+    return function () {
+      host.removeEventListener('mentat:scope', onScope);
+      host.removeEventListener('popstate', onPop);
+    };
+  }
+
+  const api = {KEYS, MODES, RESERVED, read, write, parse, serialize, href, subscribe};
+  if (typeof module !== 'undefined' && module.exports) module.exports = api;
+  else root.MentatScope = api;
+})(typeof globalThis === 'undefined' ? this : globalThis);
diff --git a/mentat/app/tests/scope.test.js b/mentat/app/tests/scope.test.js
new file mode 100644
index 000000000..836ee68be
--- /dev/null
+++ b/mentat/app/tests/scope.test.js
@@ -0,0 +1,166 @@
+/* The URL scope contract, from both ends.
+
+   Every payload here is read from the one fixture both suites import
+   (audits/mentat_failings_20260915/contracts/url_scope.json, contracts/README.md's
+   loader convention). Nothing below hand-builds a URL or a scope: a copied
+   literal is how DE-021 happened. */
+
+// Run this suite with the glob form; Node 24 rejects a bare directory, and the
+// glob cannot live in the block comment above because it closes it:
+//   node --test "app/tests/**/*.test.js"      (cwd: mentat/)
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const scope = require('../scope.js');
+
+const CONTRACTS = path.resolve(__dirname, '..', '..', '..', 'audits', 'mentat_failings_20260915', 'contracts');
+function loadContract(name) {
+  return JSON.parse(fs.readFileSync(path.join(CONTRACTS, name + '.json'), 'utf8'));
+}
+const contract = loadContract('url_scope');
+
+// "/?industry=Banking#graph" -> {query: 'industry=Banking', view: 'graph'}
+function split(url) {
+  const hash = url.indexOf('#');
+  const view = hash < 0 ? '' : url.slice(hash + 1);
+  const head = hash < 0 ? url : url.slice(0, hash);
+  const mark = head.indexOf('?');
+  return {query: mark < 0 ? '' : head.slice(mark + 1), view, pathname: mark < 0 ? head : head.slice(0, mark)};
+}
+
+// A location/history pair with no document behind it, so write() can be driven
+// from node exactly as the browser drives it.
+function fakeWindow(url) {
+  const parts = split(url);
+  const state = {
+    location: {pathname: parts.pathname || '/', search: parts.query ? '?' + parts.query : '', hash: parts.view ? '#' + parts.view : ''},
+    replaced: [],
+    events: new EventTarget()
+  };
+  state.history = {
+    replaceState(_data, _title, next) {
+      state.replaced.push(next);
+      const now = split(next);
+      state.location.pathname = now.pathname || '/';
+      state.location.search = now.query ? '?' + now.query : '';
+      state.location.hash = now.view ? '#' + now.view : '';
+    }
+  };
+  return state;
+}
+
+const urlExamples = contract.examples.filter(example => example.url);
+const writeExamples = contract.examples.filter(example => example.write);
+
+test('[url_scope] the contract itself is shaped the way contracts/README.md requires', () => {
+  assert.equal(contract.contract, 'url_scope');
+  assert.equal(contract.version, 1);
+  assert.equal(contract.owner, 'S5');
+  assert.ok(contract.produced_by.length >= 1, 'produced_by lists every producer');
+  assert.ok(contract.consumed_by.length >= 1, 'consumed_by lists every consumer');
+  assert.ok(contract.negative_controls.length >= 5, 'negative_controls is mandatory and non-empty');
+  assert.ok(urlExamples.length >= 5 && writeExamples.length >= 1);
+  // The key table and the module must name the same keys, or the table is prose.
+  assert.deepStrictEqual(
+    Object.keys(contract.keys).filter(key => key !== 'studioPane').sort(),
+    [...scope.KEYS].sort());
+  assert.deepStrictEqual(contract.reserved, [...scope.RESERVED]);
+});
+
+for (const example of urlExamples) {
+  test(`[url_scope] read() answers the contract scope for ${example.name}`, () => {
+    const parts = split(example.url);
+    assert.equal(parts.view, example.view, 'the hash names the tab');
+    assert.deepStrictEqual(scope.read(parts.query), Object.assign({}, example.scope, {invalid: []}));
+    // read() with a leading '?' is the same read; location.search carries one.
+    assert.deepStrictEqual(scope.read('?' + parts.query), Object.assign({}, example.scope, {invalid: []}));
+  });
+
+  test(`[url_scope] href() rebuilds ${example.name} byte for byte`, () => {
+    assert.equal(scope.href(example.view, example.scope, {pathname: '/'}), example.url);
+    // and serialize() is the pure half of the same rule
+    assert.equal(scope.serialize(example.scope), split(example.url).query);
+  });
+
+  test(`[url_scope] ${example.name} round-trips through write() onto an empty URL`, () => {
+    // The producer path: write() must be able to put every example on the wire.
+    const state = fakeWindow('/#' + example.view);
+    const written = scope.write(example.scope, {location: state.location, history: state.history, target: state.events});
+    assert.deepStrictEqual(written, Object.assign({}, example.scope, {invalid: []}));
+    assert.equal(state.location.search, '?' + split(example.url).query);
+    assert.equal(state.location.hash, '#' + example.view, 'write() keeps the hash');
+  });
+}
+
+for (const example of writeExamples) {
+  test(`[url_scope] write() merge semantics: ${example.name}`, () => {
+    const state = fakeWindow(example.write.before);
+    scope.write(example.write.partial, {location: state.location, history: state.history, target: state.events});
+    assert.equal(state.replaced.length, 1, 'one replaceState, never pushState');
+    assert.equal(state.replaced[0], example.write.after);
+  });
+}
+
+for (const control of contract.negative_controls) {
+  test(`[url_scope] negative control: ${control.why.split('.')[0]}`, () => {
+    const parts = split(control.url);
+    const result = scope.read(parts.query);
+    assert.deepStrictEqual(result, Object.assign({}, control.expected.scope, {invalid: control.expected.invalid}));
+    for (const bad of control.expected.invalid) {
+      assert.ok(!Object.prototype.hasOwnProperty.call(result, bad.key),
+        `${bad.key} must be absent from the scope, not merely reported`);
+    }
+    // Teeth: a value read() refuses must also be one write() will not produce,
+    // or a producer could mint the permalink this control forbids.
+    for (const bad of control.expected.invalid) {
+      if (!bad.value) continue;
+      const state = fakeWindow('/?' + bad.key + '=keep-me#' + control.view);
+      scope.write({[bad.key]: bad.value}, {location: state.location, history: state.history, target: state.events});
+      assert.equal(state.location.search, '', `write() must refuse to write ${bad.key}=${bad.value}`);
+    }
+  });
+}
+
+test('[url_scope] write() preserves unknown keys and their order, and appends new ones', () => {
+  const state = fakeWindow('/?evidence=csv&industry=Banking&offset=40&studioPane=B#evidence');
+  scope.write({industry: 'Credit Union', cycle: '2024'},
+    {location: state.location, history: state.history, target: state.events});
+  assert.equal(state.location.search, '?evidence=csv&industry=Credit%20Union&offset=40&studioPane=B&cycle=2024');
+  // S6's reserved keys survived untouched, which is the whole point of the list.
+  for (const key of contract.reserved) {
+    if (state.location.search.includes(key + '=')) assert.ok(true);
+  }
+  assert.ok(state.location.search.includes('evidence=csv'));
+  assert.ok(state.location.search.includes('offset=40'));
+});
+
+test('[url_scope] write() never writes a reserved key, even when asked', () => {
+  const state = fakeWindow('/#graph');
+  const asked = Object.fromEntries(contract.reserved.map(key => [key, 'x']));
+  scope.write(asked, {location: state.location, history: state.history, target: state.events});
+  assert.equal(state.location.search, '');
+  assert.equal(state.replaced.length, 0);
+});
+
+test('[url_scope] subscribe fires on a write, and not on a no-op write', () => {
+  const state = fakeWindow('/?industry=Banking#graph');
+  const seen = [];
+  const stop = scope.subscribe(value => seen.push(value), state.events);
+  scope.write({cycle: '2024'}, {location: state.location, history: state.history, target: state.events});
+  assert.equal(seen.length, 1, 'a change announces itself');
+  assert.deepStrictEqual(seen[0], {industry: 'Banking', cycle: '2024', invalid: []});
+  scope.write({cycle: '2024'}, {location: state.location, history: state.history, target: state.events});
+  assert.equal(seen.length, 1, 'writing the same value again announces nothing');
+  assert.equal(state.replaced.length, 1, 'and does not touch history either');
+  stop();
+  scope.write({cycle: '2022'}, {location: state.location, history: state.history, target: state.events});
+  assert.equal(seen.length, 1, 'unsubscribe stops the listener');
+});
+
+test('[url_scope] removing the last key drops the question mark rather than leaving "?"', () => {
+  const state = fakeWindow('/?industry=Banking#graph');
+  scope.write({industry: ''}, {location: state.location, history: state.history, target: state.events});
+  assert.equal(state.replaced[0], '/#graph');
+  assert.equal(state.location.search, '');
+});
diff --git a/mentat/tests/test_navigation_scope_browser.cjs b/mentat/tests/test_navigation_scope_browser.cjs
new file mode 100644
index 000000000..baed79cf1
--- /dev/null
+++ b/mentat/tests/test_navigation_scope_browser.cjs
@@ -0,0 +1,592 @@
+/* S5 (Area D), real-client pass: the hash names the tab, the query string
+ * carries the scope.
+ *
+ * What this proves that a unit test cannot: a permalink opens Graph on the
+ * right industry, company, cycle and candidate view; switching tabs, reloading
+ * and clicking through to Chart Studio all keep that scope; Cross-reference
+ * asks the server for the industry the URL names; and a saved-view permalink
+ * opens its view on a second page. Contract:
+ * audits/mentat_failings_20260915/contracts/url_scope.json.
+ *
+ * Spawn pattern and stubbing: tests/test_studio_industry_browser.cjs (real
+ * `python app/server.py` on a free port with a throwaway --data-root, the two
+ * contribution datasets stubbed because no real snapshot exists in a throwaway
+ * root) plus the graph fixture shape from tests/test_graph_lazy_tables_browser.cjs.
+ * /api/studio/views is deliberately NOT stubbed: saved views really reach disk.
+ *
+ * Run: node tests/test_navigation_scope_browser.cjs   (cwd: mentat/)
+ * Needs MENTAT_NODE_MODULES pointing at a Playwright install, or the default
+ * ~/.cache/codex-runtimes/... path used by every other .cjs test here.
+ */
+'use strict';
+const assert = require('node:assert/strict');
+const {spawn} = require('node:child_process');
+const path = require('node:path');
+const os = require('node:os');
+const fs = require('node:fs');
+const net = require('node:net');
+
+const MENTAT_DIR = path.resolve(__dirname, '..');
+const CONTRACTS = path.resolve(__dirname, '..', '..', 'audits', 'mentat_failings_20260915', 'contracts');
+const loadContract = name => JSON.parse(fs.readFileSync(path.join(CONTRACTS, name + '.json'), 'utf8'));
+const urlScope = loadContract('url_scope');
+const snapshotRegistry = loadContract('snapshot_registry');
+
+const FORBIDDEN_PORTS = new Set([8802, 8806, 8808, 8841]);
+const trace = message => { if (process.env.MENTAT_BROWSER_TRACE) console.log(`[browser] ${message}`); };
+
+function resolvePlaywright() {
+  const modules = process.env.MENTAT_NODE_MODULES
+    || path.join(os.homedir(), '.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules');
+  try {
+    return {chromium: require(require.resolve('playwright', {paths: [modules]})).chromium, modules};
+  } catch (error) {
+    return {error, modules};
+  }
+}
+
+function withTimeout(promise, ms, label) {
+  let timer;
+  const timeout = new Promise((_, reject) => {
+    timer = setTimeout(() => reject(new Error(`${label} exceeded its ${ms}ms bound`)), ms);
+  });
+  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
+}
+
+function freePort() {
+  const attemptOnce = () => new Promise((resolve, reject) => {
+    const server = net.createServer();
+    server.on('error', reject);
+    server.listen(0, '127.0.0.1', () => {
+      const port = server.address().port;
+      server.close(() => resolve(port));
+    });
+  });
+  const pick = async () => {
+    for (;;) {
+      const port = await attemptOnce();
+      if (!FORBIDDEN_PORTS.has(port)) return port;
+    }
+  };
+  return withTimeout(pick(), 10000, 'freePort()');
+}
+
+function startServer(port, dataRoot) {
+  return new Promise((resolve, reject) => {
+    const child = spawn(process.env.MENTAT_PYTHON || 'python',
+      ['app/server.py', '--port', String(port), '--data-root', dataRoot],
+      {cwd: MENTAT_DIR, stdio: ['ignore', 'pipe', 'pipe'], windowsHide: true});
+    const stderrLines = [];
+    let stdout = '';
+    let settled = false;
+    const timer = setTimeout(() => {
+      if (settled) return;
+      settled = true;
+      reject(new Error(`server on port ${port} did not print a ready line within 30s; stderr: ${stderrLines.join('')}`));
+    }, 30000);
+    child.stdout.on('data', chunk => {
+      stdout += chunk.toString();
+      trace(`server ${port} stdout: ${chunk.toString().trim()}`);
+      if (!settled && new RegExp(`Mentat app: http://127\\.0\\.0\\.1:${port}\\b`).test(stdout)) {
+        settled = true;
+        clearTimeout(timer);
+        resolve(child);
+      }
+    });
+    child.stderr.on('data', chunk => { stderrLines.push(chunk.toString()); trace(`server ${port} stderr: ${chunk.toString().trim()}`); });
+    child.on('exit', code => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      reject(new Error(`server on port ${port} exited ${code} before reporting ready; stderr: ${stderrLines.join('')}`));
+    });
+    child.on('error', error => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      reject(error);
+    });
+  });
+}
