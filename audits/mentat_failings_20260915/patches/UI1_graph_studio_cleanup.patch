+  overflow:visible;text-overflow:clip;white-space:normal}
+.studio-scope-chip>span{display:inline-flex;align-items:center;font-size:11px;color:var(--acu-plum);
+  background:var(--acu-ivory);border:1px solid var(--line);border-radius:999px;padding:3px 10px;white-space:nowrap}
+.studio-scope-chip>span.is-ready{color:var(--acu-teal);font-weight:600;background:none;border-color:transparent}
+
+/* Equal side columns, one padding, one section-label style, one scrollbar. */
+.studio-grid{grid-template-columns:280px minmax(0,1fr) 280px}
+.studio-side,.studio-inspector{max-height:82vh;overflow-y:auto}
+.studio-pane{padding:12px;overflow:visible;max-height:none}
+.studio-inspector .studio-pane{padding:12px}
+
+/* The Data source summary reads as a chip line with a ready mark. */
+.studio-source-disclosure>summary{display:flex;align-items:center;flex-wrap:wrap;gap:5px;
+  letter-spacing:0;text-transform:none;font-size:11px}
+.studio-source-disclosure>summary>span{display:inline-flex;align-items:center;font-size:11px;color:var(--acu-plum);
+  background:white;border:1px solid var(--line);border-radius:999px;padding:2px 8px;white-space:nowrap}
+.studio-source-disclosure>summary>span.is-ready{color:var(--acu-teal);font-weight:700;background:none;border-color:transparent;padding:0}
+.studio-source-disclosure>summary>span.is-waiting{color:var(--muted);background:none;border-color:transparent;padding:0;white-space:normal}
+
+/* Canvas column: title, scope subtitle, chart, one footer. */
+#studio-title:empty{display:none}
+.studio-subtitle{margin:0 0 8px;font-size:11.5px;color:var(--muted);line-height:1.5}
+.studio-subtitle:empty{display:none}
+.studio-foot{margin-top:10px;border-top:1px solid var(--line);padding-top:8px}
+.studio-foot .studio-reconcile{margin:0 0 6px}
+.studio-foot-line{display:flex;align-items:flex-start;flex-wrap:wrap;gap:8px 16px}
+.studio-foot-line #studio-note{flex:1 1 240px;margin:0}
+.studio-foot-line .studio-result-controls{flex:0 1 auto;margin:0;justify-content:flex-end}
+.studio-foot-line .studio-result-controls span{flex:0 0 auto}
+
+/* Inspector: properties first, then disclosures; no nested scroll. */
+.studio-disclosure{border-top:1px solid var(--line);margin-top:10px;padding-top:8px}
+.studio-disclosure[hidden]{display:none}
+.studio-disclosure>summary{list-style:none;cursor:pointer;font-size:11px;letter-spacing:.08em;
+  text-transform:uppercase;color:var(--acu-purple);font-weight:600;padding:2px 0}
+.studio-disclosure>summary::-webkit-details-marker{display:none}
+.studio-disclosure>summary::before{content:'\25B8 '}
+.studio-disclosure[open]>summary::before{content:'\25BE '}
+.studio-disclosure-hint{margin-left:6px;font-size:10px;letter-spacing:0;text-transform:none;
+  font-weight:400;color:var(--muted)}
+.studio-disclosure-hint:empty{display:none}
+.studio-disclosure>div{padding-top:6px}
+.studio-showme{margin:6px 0 0;border:0;background:none}
+.studio-showme-head{display:none}
+.studio-showme-grid{max-height:none;overflow:visible;padding:0;grid-template-columns:repeat(3,1fr)}
+.studio-showme-foot{border-top:0;padding:8px 0 0;min-height:0}
+.studio-options-hidden .studio-showme,.studio-options-hidden #studio-showme-details{display:none!important}
+@media print{.studio-showme,#studio-showme-details,.studio-foot{display:none!important}}
+@media (max-width:1200px){
+  .studio-grid{grid-template-columns:240px minmax(280px,1fr)}
+  .studio-side,.studio-inspector{max-height:none}
+  .studio-inspector{max-height:100vh}
+}
+@media (max-width:1000px){
+  .studio-grid{grid-template-columns:1fr}
+  .studio-side,.studio-inspector{max-height:none}
+  .studio-showme-grid{grid-template-columns:repeat(4,1fr)}
+}
