+.bars .val{text-align:right;font-variant-numeric:tabular-nums}
+.bars .pct{text-align:right;color:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
+.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle}
+.dem{background:var(--dem)}.rep{background:var(--rep)}
+.pfoot{margin-top:auto;padding-top:10px;display:flex;align-items:center;gap:12px;font-size:12px;color:var(--muted)}
+.pfoot a{color:var(--purple);margin-left:auto}
+.tool{display:flex;justify-content:flex-end;gap:14px;margin-top:16px;font-size:12.5px;color:var(--purple)}
+.spark{display:inline-block;width:46px;height:14px;vertical-align:middle}
+.stack{display:flex;height:22px;border-radius:4px;overflow:hidden;margin:10px 0 8px}
+.stack i{display:block;height:100%}
+.legend{display:flex;gap:16px;font-size:12px;color:var(--muted)}
+.legend b{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:middle}
+.tip{position:absolute;background:var(--plum);color:#fff;font-size:11.5px;padding:6px 9px;border-radius:6px;box-shadow:0 6px 18px rgba(0,0,0,.2)}
+.srow1{display:flex;align-items:center;gap:12px}
+.seg{display:inline-flex;border:1px solid var(--line);border-radius:6px;overflow:hidden;background:#fff}
+.seg span{padding:5px 12px;font-size:12.5px;color:var(--muted)}
+.seg span.on{background:var(--purple);color:#fff}
+.tb{display:flex;align-items:center;gap:6px;margin-top:12px;padding:6px 8px;background:#fff;border:1px solid var(--line);border-radius:8px}
+.tb .g{display:flex;gap:4px;align-items:center}
+.tb .d{width:1px;height:22px;background:var(--line);margin:0 6px}
+.tb .b{border:1px solid transparent;border-radius:5px;padding:4px 8px;font-size:12px;color:var(--ink)}
+.tb .b:hover{border-color:var(--line)}
+.tb .sp{flex:1}
+.tb .lay{display:inline-flex;border:1px solid var(--line);border-radius:5px;overflow:hidden}
+.tb .lay span{padding:3px 8px;font-size:11.5px;color:var(--muted)}
+.tb .lay span.on{background:var(--ivory);color:var(--plum);font-weight:600}
+.grid3{display:grid;grid-template-columns:280px 1fr 280px;gap:12px;margin-top:12px;min-height:560px}
+.pane{background:#fff;border:1px solid var(--line);border-radius:8px;padding:12px}
+.pt{font-size:10.5px;letter-spacing:.14em;color:var(--muted);margin:10px 0 6px}
+.pt:first-child{margin-top:0}
+.src{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:12px}
+.src .ok{color:var(--teal);font-weight:600}
+.search{border:1px solid var(--line);border-radius:6px;padding:5px 8px;color:var(--muted);font-size:12px;margin:8px 0 2px;background:#fff}
+.pills{display:flex;flex-direction:column;gap:5px}
+.pill{display:inline-flex;align-items:center;gap:6px;background:var(--purple);color:#fff;border-radius:999px;padding:3px 10px;font-size:11.5px;width:max-content}
+.pill.m{background:var(--teal)}
+.pill small{opacity:.8;font-size:10px}
+.shelf{display:grid;grid-template-columns:70px 1fr;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid #f1e9e1}
+.shelf b{font-size:10.5px;letter-spacing:.12em;color:var(--muted);font-weight:600}
+.shelf .drop{min-height:26px;border:1px dashed var(--line);border-radius:6px;padding:2px 6px;display:flex;gap:6px;align-items:center;color:var(--muted);font-size:12px}
+.shelf .drop .pill{padding:2px 9px}
+.ctitle{font:400 17px/1.3 var(--serif);margin:12px 0 4px}
+.ctitle small{font-family:var(--sans);color:var(--muted);font-size:12px;margin-left:8px}
+.chart{padding:6px 4px 0}
+.rec{margin-top:10px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:8px}
+.rec b{color:var(--teal)}
