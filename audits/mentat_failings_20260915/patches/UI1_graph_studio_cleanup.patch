+.disc{margin-top:10px;padding-top:10px;border-top:1px solid var(--line);font-size:12.5px;color:var(--purple)}
+.sheets{display:flex;gap:6px;margin-top:12px;font-size:12px}
+.sheets span{border:1px solid var(--line);border-radius:6px 6px 0 0;padding:5px 12px;background:#fff;color:var(--muted)}
+.sheets span.on{color:var(--plum);font-weight:600;border-bottom-color:#fff}
+.smgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
+.smgrid .sm{border:1px solid var(--line);border-radius:6px;padding:8px}
+.smgrid .sm h4{margin:0 0 6px;font:600 12px var(--sans);color:var(--muted)}
+.pop{position:absolute;right:26px;top:118px;width:320px;background:#fff;border:1px solid var(--line);border-radius:8px;box-shadow:0 10px 30px rgba(52,38,73,.18);padding:10px;z-index:3}
+.pop .tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
+.pop .tile{border:1px solid var(--line);border-radius:6px;padding:8px 4px;font-size:10px;text-align:center;color:var(--muted)}
+.pop .tile.on{border-color:var(--purple);color:var(--plum);background:var(--ivory)}
+.pop .tile i{display:block;height:18px;margin:0 auto 5px;width:22px;background:linear-gradient(90deg,var(--plum) 60%,transparent 60%);opacity:.7}
+.pop .foot{font-size:11px;color:var(--muted);margin-top:8px}
+.notes{width:1440px;margin:12px auto 32px;background:#fff;border:1px solid var(--line);border-radius:8px;padding:14px 18px;font-size:13px}
+.notes h3{margin:0 0 6px;font:400 18px var(--serif)}
+.notes ul{margin:6px 0 0 18px;padding:0}
+.notes li{margin:3px 0}
+.board{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px;min-height:560px}
+.tile{background:#fff;border:1px solid var(--line);border-radius:8px;padding:12px;display:flex;flex-direction:column}
+.tile.on{outline:2px solid var(--purple);outline-offset:-1px}
+.tile .th{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted)}
+.tile .th b{font-weight:600;color:var(--plum);border:1px solid var(--line);border-radius:6px;padding:3px 8px;background:#fff}
+.tile .th .r{margin-left:auto;display:flex;gap:10px;color:var(--purple)}
+.tile .rec{margin-top:auto}
