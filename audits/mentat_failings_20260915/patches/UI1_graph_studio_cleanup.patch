+.itabs span{padding:4px 0;color:var(--muted)}
+.itabs span.on{color:var(--plum);border-bottom:2px solid var(--purple);font-weight:600}
+.prop{display:grid;grid-template-columns:64px 1fr;align-items:center;gap:8px;margin:6px 0}
+.prop span{font-size:12px;color:var(--muted)}
