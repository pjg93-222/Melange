+  }
+
+  /* ---------------------------------------------------------------- wiring   */
+  function toggleDrawer(button, drawer) {
+    const opening = $(drawer).hidden;
+    $(drawer).hidden = !opening;
+    $(button).setAttribute('aria-expanded', String(opening));
