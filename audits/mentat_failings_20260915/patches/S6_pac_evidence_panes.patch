+
+  try { evidenceJob = localStorage.getItem('mentat-evidence-job') || ''; } catch {}
+  if (evidenceJob) { $('evidence-collect').disabled = true; pollEvidenceJob(); }
+  if (!$('view-evidence').hidden) start();
+})();

