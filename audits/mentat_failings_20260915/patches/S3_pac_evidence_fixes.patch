+  "produced_by": [
+    "mentat/app/evidence_csv.py:Store.job",
+    "mentat/app/evidence_csv.py:Upload.finish (writes import.json state 'reading', then 'ready'/'failed')",
+    "mentat/app/server.py:do_GET '/api/evidence-csv?job=<id>'",
+    "mentat/app/server.py:Console.collect_evidence (writes collection.json: 'collecting' -> 'completed'/'failed')",
+    "mentat/app/server.py:do_GET '/api/evidence-job' (synthesizes 'failed' from a dead pid found still 'collecting')"
+  ],
+  "consumed_by": [
+    "mentat/app/evidence-csv.js: poll ?job=<id> until state != 'reading'",
+    "mentat/app/app.js:pollEvidenceJob (collector job)"
+  ],
+  "description": "Two independent job-status vocabularies that cross the console/collector process boundary and are polled from the client: the evidence-CSV streaming ingest JOB (state reading|ready|failed, catalog non-null iff ready), and the PAC-evidence collector job (collection.json; state collecting|completed|failed, finished_at/message present only once the job is done). Orientation only - the examples are the contract.",
+  "examples": [
+    {
+      "id": "csv-89e9b6dc4d0b97b2f0a7b1a6c1b9a234",
+      "name": "big-import.csv",
