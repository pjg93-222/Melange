+    JSON.parse(bankingOnDisk); JSON.parse(creditUnionOnDisk); // must be valid JSON
+    console.log('--- on-disk ' + bankingItem.id + '.json (S4 browser Banking) ---');
+    console.log(bankingOnDisk);
