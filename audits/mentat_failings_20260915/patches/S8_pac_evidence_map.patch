+/* S8: the PAC evidence district map, driven in a real browser.
+ *
+ * Spawns the actual `python app/server.py` console under a temp data root on a
+ * free port, imports one industry workbook whose rows carry contributor ZIPs,
+ * opens the map from the pane header and drives it: Raised/Spent, the heat, the
+ * ranked list, the reconciliation line, a layer chip, a tooltip, a district
+ * click filtering the rows drawer, Back to panes and a URL round trip. Zero
+ * page errors are asserted at the end.
+ *
+ * Run from cwd mentat/ with MENTAT_NODE_MODULES pointing at a local Playwright:
+ *   node tests	est_evidence_map_browser.cjs [screenshot.png]
+ */
+const assert = require('node:assert/strict');
+const {spawn, execFileSync} = require('node:child_process');
+const path = require('node:path');
+const os = require('node:os');
+const fs = require('node:fs');
+const net = require('node:net');
+const modules = process.env.MENTAT_NODE_MODULES
+  || path.join(os.homedir(), '.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules');
+const {chromium} = require(require.resolve('playwright', {paths: [modules]}));
+const DIR = process.env.MENTAT_DIR || 'C:\\Users\\pgoff\\Mentat\\mentat';
+const FORBIDDEN = new Set([8802, 8806, 8808, 8841, 8940, 8971, 8990, 8991, 8992, 8993]);
+const BOOK = 'Crypto Industry Spending Overview.xlsx';
+
+const FIXTURE = `
+import sys, openpyxl
+target = sys.argv[1]
+HEAD = ['committee_id','committee_name','amount','date','two_year_transaction_period','record_type',
+        'recipient_category','include_in_analysis','inclusion_reason','contributor_name','state','zip']
+ROWS = [
+ ('C00804179','COINBASE INNOVATION PAC',383197,'2024-05-05','2024','CONTRIBUTION','Company PAC','Yes','','CHOI, EMILIE','CA','94607'),
+ ('C00804179','COINBASE INNOVATION PAC',18884,'2024-05-06','2024','CONTRIBUTION','Company PAC','Yes','','POLLAK, JESSE','CA','94105'),
+ ('C00804179','COINBASE INNOVATION PAC',5000,'2024-05-07','2024','CONTRIBUTION','Company PAC','Yes','','NO ZIP PERSON','NY',''),
+ ('C00804179','COINBASE INNOVATION PAC',1000,'2026-01-05','2026','CONTRIBUTION','Company PAC','Yes','','LATER PERSON','CA','94607'),
+]
+book = openpyxl.Workbook(); book.remove(book.active)
+for name in ('2023-2024','2025-2026'):
+    sheet = book.create_sheet(name); sheet.append(HEAD)
+    for row in ROWS:
+        if row[4] in name: sheet.append(list(row))
+book.save(target + '/${BOOK}')
+`;
+
+function freePort() {
+  return new Promise((resolve, reject) => {
+    const tryOne = () => {
+      const server = net.createServer();
+      server.on('error', reject);
+      server.listen(0, '127.0.0.1', () => {
+        const port = server.address().port;
+        server.close(() => (FORBIDDEN.has(port) ? tryOne() : resolve(port)));
+      });
+    };
+    tryOne();
+  });
+}
+
+function startServer(port, dataRoot) {
+  return new Promise((resolve, reject) => {
+    const child = spawn('python', ['app/server.py', '--port', String(port), '--data-root', dataRoot],
+      {cwd: DIR, stdio: ['ignore', 'pipe', 'pipe'], windowsHide: true});
+    let out = '', done = false;
+    const timer = setTimeout(() => { if (!done) { done = true; reject(new Error('no ready line')); } }, 30000);
+    child.stdout.on('data', chunk => {
+      out += chunk.toString();
+      if (!done && out.includes(`http://127.0.0.1:${port}`)) { done = true; clearTimeout(timer); resolve(child); }
+    });
+    child.stderr.on('data', chunk => process.stderr.write(chunk));
+  });
+}
+
+(async () => {
+  const dataRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'mentat-s8-smoke-'));
+  const fixtureDir = fs.mkdtempSync(path.join(os.tmpdir(), 'mentat-s8-fix-'));
+  let server = null, browser = null, code = 0;
+  try {
+    execFileSync('python', ['-c', FIXTURE, fixtureDir], {cwd: DIR, stdio: 'pipe'});
+    const port = await freePort();
+    server = await startServer(port, dataRoot);
+    browser = await chromium.launch({headless: true, channel: process.env.MENTAT_BROWSER_CHANNEL || 'chrome', timeout: 30000});
+    const page = await browser.newPage({viewport: {width: 1440, height: 900}});
+    const errors = [];
+    page.on('pageerror', error => errors.push('pageerror: ' + error.message));
+    page.on('console', message => { if (message.type() === 'error') errors.push('console: ' + message.text()); });
+    await page.goto(`http://127.0.0.1:${port}/#evidence`, {waitUntil: 'networkidle'});
+    await page.waitForSelector('#evidence-import-open', {timeout: 20000});
+    await page.click('#evidence-import-open');
+    await page.waitForSelector('#evidence-path', {state: 'visible', timeout: 20000});
+    await page.fill('#evidence-path', path.join(fixtureDir, BOOK));
+    await page.click('#evidence-path-read');
+    await page.waitForFunction(() =>
+      [...document.querySelectorAll('#evidence-source option')].some(o => /Crypto/.test(o.textContent)),
+      null, {timeout: 120000});
+    console.log('STEP 1 import landed');
+
+    await page.selectOption('#evidence-source', {index: 1});
+    await page.waitForFunction(() => document.querySelectorAll('#evidence-pac option').length > 0, null, {timeout: 20000});
+    await page.selectOption('#evidence-pac', 'C00804179');
+    await page.selectOption('#evidence-cycle', '2024');
+    await page.click('#evidence-add');
+    await page.waitForSelector('#evidence-panes .evidence-pane', {timeout: 20000});
+    const mapButtons = await page.locator('#evidence-panes .pane-map').count();
+    assert.equal(mapButtons, 1, 'one Map button on the pane');
+    console.log('STEP 2 pane open, Map button present');
+
+    await page.click('#evidence-panes .pane-map');
+    await page.waitForSelector('#evidence-map .map-direction', {timeout: 20000});
+    await page.click('#evidence-map .map-direction[data-direction="raised"]');
+    await page.waitForSelector('#evidence-map svg.map-canvas', {timeout: 30000});
+    const painted = await page.locator('#evidence-map path.map-district').evaluateAll(nodes =>
+      nodes.filter(node => node.style.fill && node.style.fill !== 'none').length);
+    assert.ok(painted > 0, `districts painted: ${painted}`);
+    const list = await page.locator('#evidence-map .map-list').innerText();
+    assert.ok(list.includes('CA-12'), 'the ranked list names CA-12');
+    const reconcile = await page.locator('#evidence-map .map-reconcile').innerText();
+    assert.ok(/located/.test(reconcile) && /reported/.test(reconcile), reconcile);
+    console.log(`STEP 3 raised map painted: ${painted} districts filled; reconciliation "${reconcile.slice(0, 90)}"`);
+
+    const title = await page.locator('#evidence-map path.map-district[data-key="CA-12"] title')
+      .evaluate(node => node.textContent);
+    assert.ok(/CA-12/.test(title) && /\$/.test(title), title);
+    console.log('STEP 4 tooltip: ' + title.replace(/\n/g, ' | ').slice(0, 130));
+
+    const chips = page.locator('#evidence-map .layer');
+    const before = await chips.first().getAttribute('aria-pressed');
+    await chips.first().click();
+    await page.waitForTimeout(250);
+    const after = await chips.first().getAttribute('aria-pressed');
+    assert.notEqual(before, after, 'the layer chip toggled');
+    await chips.first().click();
+    console.log(`STEP 5 layer chip toggled ${before} -> ${after}`);
+
+    await page.click('#evidence-map path.map-district[data-key="CA-12"]');
+    await page.waitForSelector('#evidence-map [data-district="CA-12"].chosen', {timeout: 15000});
+    console.log('STEP 6 district chosen');
+
+    const url = page.url();
+    assert.ok(/a\.map=raised/.test(url), url);
+    console.log('STEP 7 URL carries a.map=raised: ' + url.slice(url.indexOf('?')));
+
+    if (process.argv[2]) await page.screenshot({path: process.argv[2], fullPage: false});
+    await page.click('#evidence-map-back');
+    await page.waitForSelector('#evidence-panes .evidence-pane', {timeout: 15000});
+    assert.ok(await page.locator('#evidence-map').isHidden(), 'map hidden after Back to panes');
+    const filter = await page.locator('#evidence-panes .pane-district-filter').count();
+    console.log(`STEP 8 back to panes; rows-drawer district filter present: ${filter}`);
+
+    await page.goto(url, {waitUntil: 'networkidle'});
+    await page.waitForSelector('#evidence-map svg.map-canvas', {timeout: 60000});
+    console.log('STEP 9 permalink reopened the map');
+
+    assert.deepEqual(errors, [], 'page errors: ' + JSON.stringify(errors));
+    console.log('ALL STEPS PASSED, zero page errors');
+  } catch (error) {
+    code = 1;
+    console.error('FAILED: ' + (error && error.stack || error));
+  } finally {
+    if (browser) await browser.close();
+    if (server && server.exitCode === null) server.kill();
+    process.exit(code);
+  }
+})();
