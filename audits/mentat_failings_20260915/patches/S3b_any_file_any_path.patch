+def directory_entries(directory, limit=2000):
+    """One folder's children, folders first, with what the reader may open."""
+    rows, truncated = [], False
+    with os.scandir(directory) as scan:
+        for entry in scan:
+            if len(rows) >= limit:
+                truncated = True
+                break
