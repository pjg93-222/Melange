{
  "contract": "raw_contribution_columns",
  "version": 3,
  "owner": "S2 — Address fields and schema (audits/mentat_failings_20260915)",
  "rule": "On every listed surface the mandated columns appear in this exact order and immediately adjacent: occupation, street_1, street_2, city, state, zip. employer immediately precedes occupation on every surface (existing convention, kept). Producers keep their own constants; the tests in mentat/tests/test_raw_contribution_columns.{py,R,cjs} import this file and assert each producer against it, with a negative control that must fail.",
  "mandated_db": [
    "contributor_occupation",
    "contributor_street_1",
    "contributor_street_2",
    "contributor_city",
    "contributor_state",
    "contributor_zip"
  ],
  "block_db": [
    "contributor_employer",
    "contributor_occupation",
    "contributor_street_1",
    "contributor_street_2",
    "contributor_city",
    "contributor_state",
    "contributor_zip"
  ],
  "placement_rule": "Raw warehouse: PRAGMA table_info order, except the block is emitted contiguous at the position of its first member found in PRAGMA order (contributor_city today), members in block_db order, members absent from the table omitted and listed in the partition manifest under missing_contract_columns. All other columns keep their relative PRAGMA order.",
