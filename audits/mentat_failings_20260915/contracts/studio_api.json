  "negative_controls": [
    {
      "why": "source.industry must be a non-empty string (S4_DESIGN.md section 4); an object is the exact DE-021 shape (a field agreed in prose as 'a string' that a producer sends as something else)",
      "payload": {
        "label": "Banking",
        "reportName": "Banking Industry Spending Overview.xlsx",
        "sha256": "5777b145023675c0e5ae4947ef0055b9fc5812f8d97680b6d321498208734d31",
